<Window x:Class="AlTamam.NativeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:present="clr-namespace:AlTamam.NativePresentation;assembly=AlTamam.NativePresentation"
        Title="التمام اليومي — تجربة WPF الأصلية"
        MinWidth="920" MinHeight="600" Width="1200" Height="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FlowDirection="RightToLeft"
        Background="#F3F6FB">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#14324B" />
            <Setter Property="BorderBrush" Value="#D8E3EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="45" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>
        <Border Background="#123752" Padding="22,12">
            <StackPanel>
                <TextBlock Foreground="#FFFFFF" FontSize="25" FontWeight="Bold" Text="التمام اليومي" />
                <TextBlock Foreground="#BCE0EE" FontSize="12"
                           Text="تجربة تحويل الواجهات إلى XAML / MVVM — ليست إصدارا تشغيليا" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="12" Background="#E7F0F7" Padding="14" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="القائمة الرئيسية" FontSize="17" FontWeight="Bold" Margin="0,4,0,16"/>
                    <Button Content="الرئيسية" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static present:NativeScreen.Dashboard}" />
                    <Button Content="التمام اليومي" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static present:NativeScreen.DailyAttendance}" />
                    <Button Content="التمام الشهري" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static present:NativeScreen.MonthlyAttendance}" />
                    <Button Content="الإدارة" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static present:NativeScreen.Administration}" />
                    <Button Content="التقارير" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static present:NativeScreen.Reports}" />
                    <Button Content="الإعدادات" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static present:NativeScreen.Settings}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="14,0,0,0" Padding="20" Background="#FFFFFF" CornerRadius="12"
                    BorderBrush="#D9E3EE" BorderThickness="1">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#FCEFCF" Padding="14,8">
            <TextBlock Text="أمان البيانات: هذا النموذج لا يسجل الدخول، ولا يقرأ أو يعدل قاعدة البيانات الأصلية."
                       Foreground="#6B5019" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
