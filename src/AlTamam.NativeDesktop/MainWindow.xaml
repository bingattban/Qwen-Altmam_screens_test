<Window x:Class="AlTamam.NativeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:present="clr-namespace:AlTamam.NativePresentation;assembly=AlTamam.NativePresentation"
        xmlns:views="clr-namespace:AlTamam.NativeDesktop.Views"
        Title="التمام اليومي — WPF التجريبي"
        MinWidth="900" MinHeight="610" Width="1200" Height="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FlowDirection="RightToLeft"
        Background="#F1F5F9"
        Loaded="OnWindowLoaded" Closing="OnWindowClosing" Closed="OnWindowClosed"
        PreviewMouseDown="OnNativePointerInput" PreviewKeyDown="OnNativeKeyboardInput">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F2942"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- A real SQLCipher session is mandatory before a single shell page
             can be shown. Native Login uses NO HTML/WebView2. -->
        <views:NativeLoginView DataContext="{Binding}">
            <views:NativeLoginView.Style>
                <Style TargetType="{x:Type views:NativeLoginView}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:NativeLoginView.Style>
        </views:NativeLoginView>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0F2942" Padding="22,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="#FFFFFF" FontSize="25" FontWeight="Bold" Text="التمام اليومي"/>
                        <TextBlock Foreground="#D8E8F1" FontSize="12"
                                   Text="واجهة WPF الأصلية — تسجيل الدخول فعلي، بقية الشاشات قيد التحويل"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#163A5F" CornerRadius="8" Padding="10,7">
                            <StackPanel>
                                <TextBlock Text="{Binding Username}" Foreground="#FFFFFF" FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding RoleLabel}" Foreground="#99F6E4" FontSize="12"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="تسجيل الخروج" Background="#BE123C" Foreground="#FFFFFF"
                                BorderThickness="0" Padding="15,8" Margin="12,0,0,0"
                                FontWeight="SemiBold" Cursor="Hand" Click="OnLogoutClick"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="12" Background="#E7F0F7" BorderBrush="#CBD5E1"
                        BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="القائمة الرئيسية" FontSize="17" FontWeight="Bold"
                                   Foreground="#0F2942" Margin="0,4,0,16"/>
                        <Button Content="الرئيسية" Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static present:NativeScreen.Dashboard}"/>
                        <Button Content="التمام اليومي" Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static present:NativeScreen.DailyAttendance}"/>
                        <Button Content="التمام الشهري" Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static present:NativeScreen.MonthlyAttendance}"/>
                        <Button Content="الإدارة" Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static present:NativeScreen.Administration}"/>
                        <Button Content="التقارير" Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static present:NativeScreen.Reports}"/>
                        <Button Content="الإعدادات" Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static present:NativeScreen.Settings}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="14,0,0,0" Padding="20"
                        Background="#FFFFFF" CornerRadius="12"
                        BorderBrush="#CBD5E1" BorderThickness="1">
                    <ContentControl Content="{Binding CurrentPage}"/>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="#FEF3C7" Padding="14,10"
                    BorderBrush="#FDE68A" BorderThickness="0,1,0,0">
                <TextBlock Text="الأمان: تسجيل الدخول والجلسة والصلاحيات حقيقية. الشاشات الأخرى لا تزال معاينات غير متصلة ولا تسمح بتعديل البيانات."
                           Foreground="#845B12" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
