<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource NativeText}"/>
        <Setter Property="Background" Value="{DynamicResource NativeSubtle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NativeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NativeAccentBorder}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NativeAccentBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.48"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource NativeText}"/>
        <Setter Property="Background" Value="{DynamicResource NativeSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NativeBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource NativeText}"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource NativeText}"/>
        <Setter Property="Background" Value="{DynamicResource NativeSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NativeBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource NativeText}"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource NativeText}"/>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource NativeText}"/>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource NativeSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource NativeText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NativeBorder}"/>
        <Setter Property="RowBackground" Value="{DynamicResource NativeSurface}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource NativeSubtle}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource NativeSubtleBorder}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource NativeSubtleBorder}"/>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{DynamicResource NativeText}"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource NativeText}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource NativeOnStrong}"/>
                <Setter Property="Background" Value="{DynamicResource NativeHeaderCard}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource NativeText}"/>
        <Setter Property="Background" Value="{DynamicResource NativeSubtle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NativeBorder}"/>
    </Style>
</ResourceDictionary>
