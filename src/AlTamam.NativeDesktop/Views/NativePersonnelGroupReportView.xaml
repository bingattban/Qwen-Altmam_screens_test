<UserControl x:Class="AlTamam.NativeDesktop.Views.NativePersonnelGroupReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="GroupVisible"/>
        <Style x:Key="GroupAction" TargetType="Button">
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#0F2942"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#C80F172A"
          Visibility="{Binding IsOpen, Converter={StaticResource GroupVisible}}">
        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="9" Padding="14" Margin="12" MaxWidth="1120"
                HorizontalAlignment="Center" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button Content="إغلاق" DockPanel.Dock="Left"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource GroupAction}"/>
                    <TextBlock Text="التقرير التاريخي الموحد — تقرير جماعي (قراءة فقط)"
                               FontWeight="Bold" FontSize="19" Foreground="#0F2942"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="اختر الأفراد صراحة من كشف الإدارة الحالي (حتى 100 في الصفحة). يحتفظ التقرير بالمعرف الداخلي لكل فرد ولا يعتمد على الاسم أو الرقم (ع) كمعرف."
                               TextWrapping="Wrap" Foreground="#475569"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#BE123C"
                               TextWrapping="Wrap" FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar Height="4" IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource GroupVisible}}"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,6">
                        <TextBlock Text="اختيار مجموعة الأفراد المعتمدين" Style="{StaticResource GroupTitle}"/>
                        <ListBox x:Name="GroupPeopleSelector"
                                 ItemsSource="{Binding CandidateRows}"
                                 SelectionMode="Multiple" Height="150"
                                 SelectionChanged="OnGroupSelectionChanged"
                                 AutomationProperties.Name="حدد فردا أو أكثر من كشف الأفراد الحالي للتقرير الجماعي">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="6,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" — "/>
                                        <TextBlock Text="{Binding ServiceNumberA}"/>
                                        <TextBlock Text=" — "/>
                                        <TextBlock Text="{Binding SiteName}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding SelectedCountLabel}"
                                   Margin="0,5,0,5" Foreground="#0F2942"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="اعرض التقرير أولا لتحميل المواقع والحالات التاريخية للمجموعة. اختر المرشحات ثم اعرض التقرير مجددا. الموقع يقيّد التحضير والحركات، والحالة تقيّد التحضير فقط."
                                   TextWrapping="Wrap" Foreground="#64748B" Margin="0,6,0,3"/>
                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,5">
                            <TextBlock Text="من" VerticalAlignment="Center" Margin="7,0,3,0"/>
                            <TextBox Width="126" Height="32" MaxLength="10" Padding="6,4"
                                     FlowDirection="LeftToRight"
                                     Text="{Binding DateFromDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="تاريخ بداية التقرير الجماعي YYYY-MM-DD"/>
                            <TextBlock Text="إلى" VerticalAlignment="Center" Margin="10,0,3,0"/>
                            <TextBox Width="126" Height="32" MaxLength="10" Padding="6,4"
                                     FlowDirection="LeftToRight"
                                     Text="{Binding DateToDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="تاريخ نهاية التقرير الجماعي YYYY-MM-DD"/>
                            <TextBlock Text="نوع الحركة" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <ComboBox Width="165" MinHeight="34"
                                      ItemsSource="{Binding MovementTypeOptions}"
                                      DisplayMemberPath="Title" SelectedValuePath="Value"
                                      SelectedValue="{Binding MovementTypeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="تصفية حركات التقرير الجماعي"/>
                            <TextBlock Text="الموقع التاريخي" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <ComboBox Width="190" MinHeight="34"
                                      ItemsSource="{Binding SiteFilterOptions}"
                                      DisplayMemberPath="Title" SelectedValuePath="Id"
                                      SelectedValue="{Binding SiteIdDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="مرشح الموقع التاريخي للمجموعة"/>
                            <TextBlock Text="الحالة التاريخية" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <ComboBox Width="165" MinHeight="34"
                                      ItemsSource="{Binding StatusFilterOptions}"
                                      DisplayMemberPath="Title" SelectedValuePath="Id"
                                      SelectedValue="{Binding StatusIdDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="مرشح الحالة التاريخية للمجموعة"/>
                            <Button Content="عرض التقرير" Style="{StaticResource GroupAction}"
                                    Command="{Binding RunCommand}"/>
                            <Button Content="مسح المرشحات" Style="{StaticResource GroupAction}"
                                    Command="{Binding ClearFiltersCommand}"/>
                            <Button Content="معاينة تصدير التقرير الجماعي Excel"
                                    Style="{StaticResource GroupAction}"
                                    Command="{Binding Excel.OpenPreviewCommand}"
                                    AutomationProperties.Name="معاينة تصدير تاريخ المجموعة إلى ملف Excel قبل تأكيد الإنشاء"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding AppliedFiltersLabel}"
                                   TextWrapping="Wrap" Foreground="#0F2942"
                                   FontWeight="SemiBold"/>
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1"
                                BorderThickness="1" CornerRadius="6"
                                Padding="9" Margin="0,7">
                            <WrapPanel>
                                <TextBlock Text="عدد الأفراد: " FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Report.PersonCount}" Margin="0,0,15,0"/>
                                <TextBlock Text="إجمالي التحضير: " FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Report.AttendanceTotal}" Margin="0,0,15,0"/>
                                <TextBlock Text="إجمالي الحركات: " FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Report.MovementTotal}"/>
                            </WrapPanel>
                        </Border>
                        <TextBlock Text="الأفراد وبياناتهم الحالية مع أعداد التحضير والحركات التاريخية المحفوظة"
                                   Style="{StaticResource GroupTitle}"/>
                        <TextBlock Text="حدد صف الفرد لعرض تفاصيل حالاته التاريخية المعتمدة ضمن الفترة المحددة."
                                   Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <DataGrid ItemsSource="{Binding Report.Persons}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  Height="320" AlternatingRowBackground="#F8FAFC"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  RowDetailsVisibilityMode="VisibleWhenSelected"
                                  AutomationProperties.Name="المجموعة المختارة بمعرفات الأفراد ومجاميع أصلية">
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <StackPanel Background="#F1F5F9" Margin="4">
                                        <TextBlock Text="تفاصيل حالات الفرد المحدد" FontWeight="SemiBold"
                                                   Foreground="#0F2942" Margin="8,6"/>
                                        <DataGrid ItemsSource="{Binding StatusTotals}" AutoGenerateColumns="False"
                                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                                  MaxHeight="155" Margin="8,0,8,8"
                                                  AutomationProperties.Name="الحالات التاريخية للفرد المحدد">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="الحالة التاريخية" Binding="{Binding StatusName}" Width="2*"/>
                                                <DataGridTextColumn Header="عدد الأيام" Binding="{Binding Count}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم الحالي" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="*"/>
                                <DataGridTextColumn Header="أول تسجيل" Binding="{Binding FirstRecordedDate}" Width="*"/>
                                <DataGridTextColumn Header="أيام التحضير" Binding="{Binding AttendanceTotal}" Width="*"/>
                                <DataGridTextColumn Header="الحركات" Binding="{Binding MovementTotal}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="إجماليات حالات التحضير (المجموعة كاملة)" Style="{StaticResource GroupTitle}"/>
                        <DataGrid ItemsSource="{Binding Report.StatusTotals}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  Height="145" AlternatingRowBackground="#F8FAFC"
                                  AutomationProperties.Name="إجماليات الحالات الأصلية للمجموعة">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الحالة التاريخية" Binding="{Binding StatusName}" Width="2*"/>
                                <DataGridTextColumn Header="عدد الأيام" Binding="{Binding Count}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,8,0,3">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding PreviousSummaryCommand}"
                                        Style="{StaticResource GroupAction}"/>
                                <Button Content="التالي" Command="{Binding NextSummaryCommand}"
                                        Style="{StaticResource GroupAction}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DailySummaryPageLabel}"
                                       Style="{StaticResource GroupTitle}"/>
                        </DockPanel>
                        <TextBlock Text="الملخص اليومي من السجلات المعتمدة فقط؛ الصفحات 100 سجل، والإجماليات مستقلة عن الصفحة."
                                   Foreground="#64748B" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Report.DailyStatuses}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  Height="195" AlternatingRowBackground="#F8FAFC"
                                  AutomationProperties.Name="الملخص اليومي المجمع للحالات من قاعدة SQLCipher">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="*"/>
                                <DataGridTextColumn Header="الحالة التاريخية" Binding="{Binding StatusName}" Width="2*"/>
                                <DataGridTextColumn Header="عدد التحضير" Binding="{Binding Count}" Width="*"/>
                                <DataGridTextColumn Header="عدد الأفراد" Binding="{Binding PersonCount}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="هذا التقرير للقراءة فقط من SQLCipher. اختيار المجموعة مقصور على الصفحة الحالية؛ اختيار المجموعة عبر صفحات متعددة ضمن مراحل لاحقة."
                                   Foreground="#64748B" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <!-- Separate operator approval: no export on preview, no retry
                     after an uncertain commit, no user-controlled file path. -->
                <Border Grid.RowSpan="3" Background="#D10F172A" Panel.ZIndex="50"
                        DataContext="{Binding Excel}"
                        Visibility="{Binding IsOpen, Converter={StaticResource GroupVisible}}">
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                            CornerRadius="10" Padding="18" MaxWidth="620"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button Content="إغلاق" DockPanel.Dock="Left"
                                        Command="{Binding CloseCommand}"
                                        Style="{StaticResource GroupAction}"/>
                                <TextBlock Text="معاينة تصدير Excel — التقرير التاريخي الجماعي"
                                           FontSize="17" FontWeight="Bold"
                                           Foreground="#0F2942"/>
                            </DockPanel>
                            <TextBlock Text="سيتم تصدير السجلات الأصلية المعتمدة للفترة المختارة في 4 أوراق Excel بترتيب المجموعة، بما فيها صفحات الملخص اليومي كاملة ضمن الحد الآمن. لا يتغير التحضير أو قاعدة البيانات."
                                       TextWrapping="Wrap" Foreground="#475569"/>
                            <ProgressBar Height="4" IsIndeterminate="True" Margin="0,7,0,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource GroupVisible}}"/>
                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap"
                                       Foreground="#BE123C" FontWeight="SemiBold"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Border Background="#F1F5F9" Padding="10" CornerRadius="7"
                                    Margin="0,8,0,8">
                                <StackPanel>
                                    <TextBlock Text="المعاينة الأصلية قبل التأكيد" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Preview.SuggestedFileName}"/>
                                    <WrapPanel Margin="0,5,0,0">
                                        <TextBlock Text="عدد الأفراد: "/>
                                        <TextBlock Text="{Binding Preview.PersonCount}" Margin="0,0,14,0"/>
                                        <TextBlock Text="أيام التحضير: "/>
                                        <TextBlock Text="{Binding Preview.AttendanceTotal}" Margin="0,0,14,0"/>
                                        <TextBlock Text="الحركات: "/>
                                        <TextBlock Text="{Binding Preview.MovementTotal}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="حفظ محلي داخل مجلد التقارير المعتمد مسبقا؛ لا توجد إمكانية لمسار خارجي أو ملف باسم مكرر. قد تستغرق قراءة جميع الصفحات وقتا على البيانات الكبيرة."
                                       TextWrapping="Wrap" Foreground="#64748B"/>
                            <Button Content="تأكيد إنشاء ملف Excel"
                                    Command="{Binding ConfirmCommand}"
                                    Style="{StaticResource GroupAction}"
                                    AutomationProperties.Name="تأكيد تصدير التقرير الجماعي بعد معاينة الأفراد والمجاميع"/>
                            <TextBlock Text="{Binding CompletionMessage}" Foreground="#047857"
                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Receipt.FilePath}" TextWrapping="Wrap"
                                       Foreground="#0F2942"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
