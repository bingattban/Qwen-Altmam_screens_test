<UserControl x:Class="AlTamam.NativeDesktop.Views.NativeMonthlyAttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI" Background="{DynamicResource NativeSurface}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibilityIfTrue"/>
        <Style x:Key="MonthlyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource NativeAccentFill}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource NativeSubtle}" BorderBrush="{DynamicResource NativeSubtleBorder}"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding PageHeading}"
                           Foreground="{DynamicResource NativeText}" FontSize="22" FontWeight="Bold"/>
                <TextBlock HorizontalAlignment="Left" FlowDirection="LeftToRight"
                           Foreground="{DynamicResource NativeMuted}" Text="{Binding SelectedPeriod}"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" IsEnabled="{Binding CanChangeMonthlyScope}" Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeSubtleBorder}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <WrapPanel>
                <StackPanel Margin="4" MinWidth="140">
                    <TextBlock Text="شهر الأرشيف" Foreground="{DynamicResource NativeText}" FontWeight="SemiBold"/>
                    <ComboBox Width="145" Height="34" Margin="0,4,0,0"
                              ItemsSource="{Binding Periods}"
                              DisplayMemberPath="Label" SelectedValuePath="Period"
                              SelectedValue="{Binding SelectedPeriod, Mode=OneWay}"
                              SelectionChanged="OnPeriodChanged"
                              AutomationProperties.Name="اختيار شهر التمام من الأرشيف المعتمد"/>
                </StackPanel>
                <StackPanel Margin="4" MinWidth="140">
                    <TextBlock Text="الموقع" Foreground="{DynamicResource NativeText}" FontWeight="SemiBold"/>
                    <ComboBox Width="155" Height="34" Margin="0,4,0,0"
                              ItemsSource="{Binding SiteOptions}"
                              DisplayMemberPath="Name" SelectedValuePath="SiteId"
                              SelectedValue="{Binding SelectedSiteId, Mode=OneWay}"
                              SelectionChanged="OnSiteChanged"
                              AutomationProperties.Name="تصفية كشف الشهر حسب الموقع"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="الاسم أو الرقم (ع) في الشهر المختار"
                               Foreground="{DynamicResource NativeText}" FontWeight="SemiBold"/>
                    <TextBox Width="190" Height="34" Margin="0,4,0,0" Padding="8,4"
                             Text="{Binding SearchDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="بحث تاريخي في كشف الشهر"/>
                </StackPanel>
                <Button Style="{StaticResource MonthlyButton}" Content="بحث"
                        VerticalAlignment="Bottom" Command="{Binding SearchCommand}"/>
                <Button Style="{StaticResource MonthlyButton}" Content="مسح"
                        VerticalAlignment="Bottom" Command="{Binding ClearSearchCommand}"/>
                <Button Style="{StaticResource MonthlyButton}" Content="تحديث"
                        VerticalAlignment="Bottom" Command="{Binding RefreshCommand}"/>
                <Button Style="{StaticResource MonthlyButton}" Content="التمام الجاري"
                        VerticalAlignment="Bottom" Command="{Binding ShowLiveMonthCommand}"/>
                <Button Style="{StaticResource MonthlyButton}" Content="أرشيف الشهر الجاري"
                        VerticalAlignment="Bottom" Command="{Binding ShowCurrentArchiveCommand}"/>
                <Button Style="{StaticResource MonthlyButton}" Content="معاينة تصدير Excel"
                        VerticalAlignment="Bottom" Command="{Binding Excel.OpenPreviewCommand}"
                        AutomationProperties.Name="معاينة تصدير التمام الشهري إلى Excel قبل التأكيد"/>
            </WrapPanel>
        </Border>
        <StackPanel Grid.Row="2" Margin="4,2,4,8">
            <TextBlock Text="حدد الشهر والموقع والبحث، ثم اضغط معاينة تصدير Excel. لجميع المواقع ينشأ كشف موحد وكشف لكل موقع ذي أفراد. لا يتم إنشاء ملفات حتى التأكيد."
                       Visibility="{Binding IsRosterExportEntry, Converter={StaticResource VisibilityIfTrue}}"
                       FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource NativeAccentText}" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding MonthModeLabel}" FontWeight="SemiBold" Foreground="{DynamicResource NativeText}"/>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}"/>
            <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap"
                       Foreground="{DynamicResource NativeDangerText}" FontWeight="SemiBold"
                       AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar Height="4" IsIndeterminate="True" Foreground="{DynamicResource NativeAccentText}"
                         Visibility="{Binding IsLoading, Converter={StaticResource VisibilityIfTrue}}"/>
        </StackPanel>
        <DataGrid x:Name="MonthlyGrid" Grid.Row="3" ItemsSource="{Binding Rows}" IsEnabled="{Binding CanChangeMonthlyScope}"
                  IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" HeadersVisibility="Column"
                  SelectionMode="Single" RowHeight="35" ColumnHeaderHeight="38"
                  AlternatingRowBackground="{DynamicResource NativeSubtle}" GridLinesVisibility="Horizontal"
                  BorderThickness="1" BorderBrush="{DynamicResource NativeBorder}" MinHeight="190"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الرقم" Binding="{Binding RowNumber}" Width="62"/>
                <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="95"/>
                <DataGridTextColumn Header="الرتبة" Binding="{Binding Rank}" Width="95"/>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,8,0,0" IsEnabled="{Binding CanChangeMonthlyScope}">
            <TextBlock Text="{Binding PageLabel}" DockPanel.Dock="Right"
                       Foreground="{DynamicResource NativeMuted}" VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="السابق" Style="{StaticResource MonthlyButton}"
                        Command="{Binding PreviousPageCommand}"/>
                <Button Content="التالي" Style="{StaticResource MonthlyButton}"
                        Command="{Binding NextPageCommand}"/>
            </StackPanel>
        </DockPanel>
        <!-- Authenticated, read-only canonical detail. Closing or navigating
             away revokes in-flight reads; no write buttons are offered. -->
        <Border Grid.RowSpan="5" Background="#B80F172A" Panel.ZIndex="110"
                Visibility="{Binding IsCellDetailsOpen, Converter={StaticResource VisibilityIfTrue}}">
            <Border Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="18" Width="590" MaxHeight="560"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="تفاصيل يوم التمام الشهري" FontSize="19"
                                   FontWeight="Bold" Foreground="{DynamicResource NativeText}"
                                   VerticalAlignment="Center" DockPanel.Dock="Right"/>
                        <Button Content="إغلاق" Command="{Binding CloseCellDetailsCommand}"
                                Style="{StaticResource MonthlyButton}"
                                AutomationProperties.Name="إغلاق تفاصيل اليوم"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ProgressBar Height="5" IsIndeterminate="True"
                                         Visibility="{Binding IsCellDetailsLoading, Converter={StaticResource VisibilityIfTrue}}"/>
                            <TextBlock Text="{Binding CellDetailsError}" Foreground="{DynamicResource NativeDangerText}"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="{Binding SelectedCellDateLabel}" FontSize="15"
                                       FontWeight="SemiBold" Foreground="{DynamicResource NativeAccentText}"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            <TextBlock Text="اسم الفرد في التاريخ المحدد" FontWeight="Bold"
                                       Foreground="{DynamicResource NativeSecondary}" Margin="0,10,0,2"/>
                            <TextBlock Text="{Binding SelectedCellDetails.PersonName}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource NativeText}"/>
                            <TextBlock Text="الرقم (ع) في ذلك التاريخ" FontWeight="Bold"
                                       Foreground="{DynamicResource NativeSecondary}" Margin="0,10,0,2"/>
                            <TextBlock Text="{Binding SelectedCellDetails.ServiceNumberA}" Foreground="{DynamicResource NativeText}"/>
                            <TextBlock Text="الموقع في ذلك التاريخ" FontWeight="Bold"
                                       Foreground="{DynamicResource NativeSecondary}" Margin="0,10,0,2"/>
                            <TextBlock Text="{Binding SelectedCellDetails.SiteName}" Foreground="{DynamicResource NativeText}"/>
                            <Separator Margin="0,12,0,8"/>
                            <TextBlock Text="حالة الحضور المحفوظة" FontWeight="Bold"
                                       Foreground="{DynamicResource NativeSecondary}" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding SelectedCellDetails.AttendanceStatus}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource NativeText}"/>
                            <TextBlock Text="الموقع وقت تسجيل الحضور" FontWeight="Bold"
                                       Foreground="{DynamicResource NativeSecondary}" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedCellDetails.AttendanceSiteName}" Foreground="{DynamicResource NativeText}"/>
                            <TextBlock Text="مصدر التسجيل وتوقيته" FontWeight="Bold"
                                       Foreground="{DynamicResource NativeSecondary}" Margin="0,8,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedCellDetails.AttendanceSource}"
                                           Foreground="{DynamicResource NativeText}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding SelectedCellDetails.AttendanceCommittedAtUtc}"
                                           Foreground="{DynamicResource NativeText}" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <Separator Margin="0,12,0,8"/>
                            <TextBlock Text="حركة الفرد" FontWeight="Bold"
                                       Foreground="{DynamicResource NativeSecondary}" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding SelectedCellDetails.MovementSummary}"
                                       Foreground="{DynamicResource NativeText}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedCellDetails.MovementReason}"
                                       Foreground="{DynamicResource NativeText}" TextWrapping="Wrap"/>
                            <TextBlock Text="سجل التعديلات المسجلة" FontWeight="Bold"
                                       Foreground="{DynamicResource NativeText}" Margin="0,12,0,6"/>
                            <ItemsControl ItemsSource="{Binding SelectedCellDetails.Revisions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource NativeSubtle}" BorderBrush="{DynamicResource NativeSubtleBorder}"
                                                BorderThickness="1" CornerRadius="5"
                                                Margin="0,2" Padding="8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding BeforeStatus}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text=" ← "/>
                                                    <TextBlock Text="{Binding AfterStatus}"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ActorUserId}" Foreground="{DynamicResource NativeMuted}"/>
                                                <TextBlock Text="{Binding ExecutedAtUtc}" Foreground="{DynamicResource NativeMuted}"
                                                           FlowDirection="LeftToRight"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource NativeSecondary}"
                                       TextWrapping="Wrap"
                                       Text="العرض التاريخي لا يغير السجلات. التصحيح الاستثنائي يخضع للصلاحيات وسياسة اليوم المغلق."/>
                            <Button Content="تصحيح استثنائي لليوم المحدد" Style="{StaticResource MonthlyButton}"
                                    Command="{Binding OpenCorrectionCommand}"
                                    Visibility="{Binding CanOpenCorrection, Converter={StaticResource VisibilityIfTrue}}"/>
                            <Border BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1" CornerRadius="6" Padding="10"
                                    Visibility="{Binding Correction.IsOpen, Converter={StaticResource VisibilityIfTrue}}">
                                <StackPanel>
                                    <TextBlock Text="تصحيح استثنائي — يوم تاريخي واحد" FontWeight="Bold" Foreground="{DynamicResource NativeText}"/>
                                    <TextBlock Text="اختر الحالة الجديدة وأدخل السبب (10 إلى 400 حرف). لا اعتماد قبل المعاينة." TextWrapping="Wrap"/>
                                    <ComboBox ItemsSource="{Binding Correction.StatusChoices}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="StatusId" SelectedValue="{Binding Correction.SelectedStatusId, Mode=TwoWay}"
                                              IsEnabled="{Binding Correction.CanEdit}" Margin="0,6" AutomationProperties.Name="الحالة الجديدة"/>
                                    <TextBox Text="{Binding Correction.Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="400" TextWrapping="Wrap" MinHeight="40"
                                             IsEnabled="{Binding Correction.CanEdit}" AutomationProperties.Name="سبب التصحيح الاستثنائي"/>
                                    <Button Content="معاينة التصحيح" Command="{Binding Correction.PreviewCommand}" Style="{StaticResource MonthlyButton}"/>
                                    <TextBlock Text="{Binding Correction.Error}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"/>
                                    <ProgressBar Height="4" IsIndeterminate="True"
                                                 Visibility="{Binding Correction.IsBusy, Converter={StaticResource VisibilityIfTrue}}"/>
                                    <TextBlock Text="الحالة السابقة:" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Correction.Preview.BeforeStatusName}" TextWrapping="Wrap"/>
                                    <TextBlock Text="الحالة الجديدة:" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Correction.Preview.AfterStatusName}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Correction.Preview.Request.Reason}" TextWrapping="Wrap"/>
                                    <Button Content="{Binding Correction.ConfirmLabel}" Command="{Binding Correction.ConfirmCommand}" Style="{StaticResource MonthlyButton}"/>
                                    <TextBlock Text="{Binding Correction.CompletionMessage}" Foreground="{DynamicResource NativeAccentText}" TextWrapping="Wrap"/>
                                    <Button Content="إغلاق مراجعة التصحيح" Command="{Binding CloseCorrectionCommand}" Style="{StaticResource MonthlyButton}"/>
                                </StackPanel>
                            </Border>
                            <Button Content="تعديل تمام سابق لفترة محددة" Style="{StaticResource MonthlyButton}"
                                    Command="{Binding OpenRangeCorrectionCommand}"
                                    Visibility="{Binding CanOpenRangeCorrection, Converter={StaticResource VisibilityIfTrue}}"/>
                            <Border BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1" CornerRadius="6" Padding="10"
                                    Visibility="{Binding RangeCorrection.IsOpen, Converter={StaticResource VisibilityIfTrue}}">
                                <StackPanel>
                                    <TextBlock Text="تعديل تمام سابق — فترة محددة" FontWeight="Bold" Foreground="{DynamicResource NativeText}"/>
                                    <TextBlock Text="حدد من يوم إلى 62 يوما للفرد المحدد. تشمل المعاينة الأيام المؤهلة في جميع مواقعه التاريخية؛ لا تحفظ الأيام غير المدرجة." TextWrapping="Wrap"/>
                                    <TextBlock Text="من تاريخ (yyyy-MM-dd)" Margin="0,8,0,2"/>
                                    <TextBox Text="{Binding RangeCorrection.FromText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="10" FlowDirection="LeftToRight" IsEnabled="{Binding RangeCorrection.CanEdit}"
                                             AutomationProperties.Name="بداية فترة تعديل التمام"/>
                                    <TextBlock Text="إلى تاريخ (yyyy-MM-dd)" Margin="0,8,0,2"/>
                                    <TextBox Text="{Binding RangeCorrection.ToText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="10" FlowDirection="LeftToRight" IsEnabled="{Binding RangeCorrection.CanEdit}"
                                             AutomationProperties.Name="نهاية فترة تعديل التمام"/>
                                    <ComboBox ItemsSource="{Binding RangeCorrection.StatusChoices}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="StatusId" SelectedValue="{Binding RangeCorrection.SelectedStatusId, Mode=TwoWay}"
                                              IsEnabled="{Binding RangeCorrection.CanEdit}" Margin="0,6" AutomationProperties.Name="حالة الفترة الجديدة"/>
                                    <TextBox Text="{Binding RangeCorrection.Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="400" TextWrapping="Wrap" MinHeight="40"
                                             IsEnabled="{Binding RangeCorrection.CanEdit}" AutomationProperties.Name="سبب تعديل الفترة"/>
                                    <Button Content="معاينة الأيام قبل التعديل" Command="{Binding RangeCorrection.PreviewCommand}" Style="{StaticResource MonthlyButton}"/>
                                    <TextBlock Text="{Binding RangeCorrection.Error}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"/>
                                    <ProgressBar Height="4" IsIndeterminate="True"
                                                 Visibility="{Binding RangeCorrection.IsBusy, Converter={StaticResource VisibilityIfTrue}}"/>
                                    <TextBlock Text="{Binding RangeCorrection.Preview.PersonName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding RangeCorrection.Preview.ServiceNumberA}"/>
                                    <TextBlock Text="{Binding RangeCorrection.PreviewSummary}" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding RangeCorrection.Preview.Days}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource NativeSubtle}" BorderBrush="{DynamicResource NativeSubtleBorder}" BorderThickness="1" CornerRadius="5" Margin="0,2" Padding="6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding BusinessDate, StringFormat=yyyy-MM-dd}" FlowDirection="LeftToRight" HorizontalAlignment="Right" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding SiteName}" Foreground="{DynamicResource NativeMuted}"/>
                                                        <TextBlock Text="{Binding BeforeStatusName}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding AfterStatusName}" Foreground="{DynamicResource NativeAccentText}" FontWeight="Bold" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding RangeCorrection.Preview.Request.Reason}" TextWrapping="Wrap"/>
                                    <Button Content="{Binding RangeCorrection.ConfirmLabel}" Command="{Binding RangeCorrection.ConfirmCommand}" Style="{StaticResource MonthlyButton}"/>
                                    <TextBlock Text="{Binding RangeCorrection.CompletionMessage}" Foreground="{DynamicResource NativeAccentText}" TextWrapping="Wrap"/>
                                    <Button Content="إغلاق مراجعة الفترة" Command="{Binding CloseRangeCorrectionCommand}" Style="{StaticResource MonthlyButton}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
        <!-- Native WPF Excel is a two-step, operator-approved action.
             Original MonthlyExcelExportService owns safe path, files, and cleanup. -->
        <Border Grid.RowSpan="5" Background="#B80F172A" Panel.ZIndex="120"
                Visibility="{Binding Excel.IsOpen, Converter={StaticResource VisibilityIfTrue}}">
            <Border Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="18" Width="550" MaxHeight="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="معاينة تصدير التمام الشهري" FontSize="19"
                                   FontWeight="Bold" Foreground="{DynamicResource NativeText}"
                                   VerticalAlignment="Center" DockPanel.Dock="Right"/>
                        <Button Content="إغلاق" Command="{Binding Excel.CloseCommand}"
                                Style="{StaticResource MonthlyButton}"
                                AutomationProperties.Name="إلغاء وإغلاق معاينة Excel"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="المصدر: الأرشيف الشهري المعتمد في SQLCipher"
                                       Foreground="{DynamicResource NativeMuted}" TextWrapping="Wrap"/>
                            <ProgressBar Height="8" Minimum="0" Maximum="100"
                                         Value="{Binding Excel.ProgressPercent, Mode=OneWay}"
                                         IsIndeterminate="{Binding Excel.IsProgressIndeterminate}"
                                         Visibility="{Binding Excel.IsBusy, Converter={StaticResource VisibilityIfTrue}}"
                                         AutomationProperties.Name="تقدم إنشاء ملفات Excel"/>
                            <TextBlock Text="{Binding Excel.ProgressMessage}" Foreground="{DynamicResource NativeText}"
                                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <Button Content="طلب إيقاف التصدير الجاري" Command="{Binding Excel.CancelExportCommand}"
                                    Style="{StaticResource MonthlyButton}"
                                    Visibility="{Binding Excel.IsExporting, Converter={StaticResource VisibilityIfTrue}}"/>
                            <TextBlock Text="{Binding Excel.Error}" Foreground="{DynamicResource NativeDangerText}"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="الشهر المختار" FontWeight="Bold" Foreground="{DynamicResource NativeSecondary}"
                                       Margin="0,12,0,3"/>
                            <TextBlock Text="{Binding Excel.Preview.Period}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource NativeText}" FlowDirection="LeftToRight"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="الموقع المختار" FontWeight="Bold" Foreground="{DynamicResource NativeSecondary}"
                                       Margin="0,8,0,3"/>
                            <TextBlock Text="{Binding Excel.Preview.SiteName}" Foreground="{DynamicResource NativeText}"/>
                            <TextBlock Text="البحث المطبق" FontWeight="Bold" Foreground="{DynamicResource NativeSecondary}"
                                       Margin="0,8,0,3"/>
                            <TextBlock Text="{Binding Excel.Preview.SearchTerm}" Foreground="{DynamicResource NativeText}"/>
                            <TextBlock Text="عدد الأفراد ضمن المعاينة" FontWeight="Bold"
                                       Foreground="{DynamicResource NativeSecondary}" Margin="0,8,0,3"/>
                            <TextBlock Text="{Binding Excel.Preview.PersonCount}" Foreground="{DynamicResource NativeText}"
                                       FontWeight="SemiBold"/>
                            <StackPanel Visibility="{Binding Excel.HasDestinationReview, Converter={StaticResource VisibilityIfTrue}}"
                                        IsEnabled="{Binding Excel.CanEditDestination}">
                                <TextBlock Text="اسم ملف Excel" FontWeight="Bold" Foreground="{DynamicResource NativeSecondary}" Margin="0,8,0,3"/>
                                <TextBox Text="{Binding Excel.OutputFileName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="124" AutomationProperties.Name="اسم ملف Excel"/>
                                <TextBlock Text="مجلد الحفظ المحلي" FontWeight="Bold" Foreground="{DynamicResource NativeSecondary}" Margin="0,8,0,3"/>
                                <TextBlock Text="{Binding Excel.OutputDirectory}" TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                                <Button Content="اختيار مجلد لهذا التصدير" Click="OnChooseExportFolder"
                                        Style="{StaticResource MonthlyButton}"/>
                            </StackPanel>
                            <TextBlock Text="اختر مجلدا محليا صالحا واسما آمنا بصيغة xlsx. اختيار المجلد هنا يخص هذا التصدير فقط. عند اختيار جميع المواقع ينشئ النظام كشفا موحدا وكشوفا لكل موقع، ولا يستبدل ملفات سابقة."
                                       Foreground="{DynamicResource NativeMuted}" TextWrapping="Wrap" Margin="0,12,0,8"/>
                            <Button Content="تأكيد تصدير Excel"
                                    Style="{StaticResource MonthlyButton}"
                                    Command="{Binding Excel.ConfirmCommand}"
                                    AutomationProperties.Name="تأكيد إنشاء ملفات Excel في المجلد المعتمد"/>
                            <TextBlock Text="{Binding Excel.CompletionMessage}"
                                       Foreground="{DynamicResource NativeAccentText}" FontWeight="Bold"
                                       TextWrapping="Wrap" Margin="0,10,0,2"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="{Binding Excel.Receipt.PrimaryFilePath}"
                                       Foreground="{DynamicResource NativeText}" TextWrapping="Wrap"
                                       FlowDirection="LeftToRight"/>
                            <DataGrid ItemsSource="{Binding Excel.ResultFiles}"
                                      Visibility="{Binding Excel.HasResultFiles, Converter={StaticResource VisibilityIfTrue}}"
                                      AutomationProperties.Name="قائمة ملفات Excel المحفوظة"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      MaxHeight="235" MinHeight="85" Margin="0,10,0,0"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="130"/>
                                    <DataGridTextColumn Header="الأفراد" Binding="{Binding PersonCount}" Width="65"/>
                                    <DataGridTextColumn Header="مسار الملف" Binding="{Binding FilePath}" Width="340"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
