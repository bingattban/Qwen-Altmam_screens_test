<UserControl x:Class="AlTamam.NativeDesktop.Views.NativeStatusCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="StatusVisible"/>
        <Style x:Key="StatusButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource NativeAccentFill}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#C80F172A"
          Visibility="{Binding IsOpen, Converter={StaticResource StatusVisible}}">
        <Border Background="White" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                CornerRadius="10" Padding="15" Margin="12"
                Width="850" MaxWidth="960" MaxHeight="730"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Left" Content="إغلاق"
                            Style="{StaticResource StatusButton}"
                            Command="{Binding CloseCommand}"
                            AutomationProperties.Name="إغلاق إدارة الحالات"/>
                    <TextBlock Text="إدارة حالات التحضير — سجل SQLCipher"
                               FontSize="19" FontWeight="Bold"
                               Foreground="{DynamicResource NativeText}" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="الحالات النشطة المعتمدة فقط. الاسم والرمز واللون والإصدار وعدد مرات التحضير اليوم من السجل الأصلي. التعطيل لا يحذف أي سجل قديم."
                                   Foreground="{DynamicResource NativeMuted}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,7">
                            <Button Content="إضافة حالة"
                                    Style="{StaticResource StatusButton}"
                                    Command="{Binding CreateCommand}"
                                    AutomationProperties.Name="بدء إضافة حالة تحضير جديدة"/>
                            <Button Content="تعديل الحالة المحددة"
                                    Style="{StaticResource StatusButton}"
                                    Command="{Binding EditCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=StatusGrid}"
                                    AutomationProperties.Name="تعديل الحالة المحددة مع مراجعة"/>
                            <Button Content="تعطيل الحالة المحددة"
                                    Style="{StaticResource StatusButton}"
                                    Command="{Binding DeactivateCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=StatusGrid}"
                                    AutomationProperties.Name="بدء مراجعة تعطيل حالة دون محو التاريخ"/>
                            <Button Content="تحديث"
                                    Style="{StaticResource StatusButton}"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                        <ProgressBar Height="4" IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource StatusVisible}}"/>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NativeDangerText}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <DataGrid x:Name="StatusGrid" Margin="0,8,0,8" MinHeight="170"
                                  MaxHeight="260"
                                  ItemsSource="{Binding Statuses}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" RowHeight="34"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  AlternatingRowBackground="#F8FAFC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم الحالة" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="الرمز" Binding="{Binding Symbol}" Width="75"/>
                                <DataGridTextColumn Header="اللون" Binding="{Binding Color}" Width="100"/>
                                <DataGridTextColumn Header="مرات اليوم" Binding="{Binding TodayCount}" Width="90"/>
                                <DataGridTextColumn Header="الإصدار" Binding="{Binding Revision}" Width="65"/>
                                <DataGridTextColumn Header="المعرف الثابت" Binding="{Binding StatusId}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Background="{DynamicResource NativeSubtle}" BorderBrush="{DynamicResource NativeBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="12"
                                Visibility="{Binding HasDraft, Converter={StaticResource StatusVisible}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Heading}" FontWeight="Bold"
                                           FontSize="17" Foreground="{DynamicResource NativeText}"
                                           Margin="0,0,0,9"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="3">
                                        <TextBlock Text="الاسم (2–75 حرفا)" FontWeight="SemiBold"/>
                                        <TextBox Height="35" Padding="7,4" Margin="0,4,0,0"
                                                 Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanEditFields}"
                                                 AutomationProperties.Name="اسم حالة التحضير"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3">
                                        <TextBlock Text="الرمز (1–5)" FontWeight="SemiBold"/>
                                        <TextBox Height="35" Padding="7,4" Margin="0,4,0,0"
                                                 Text="{Binding DraftSymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanEditFields}"
                                                 AutomationProperties.Name="رمز حالة التحضير"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="3">
                                        <TextBlock Text="لون HEX (#RRGGBB)" FontWeight="SemiBold"/>
                                        <TextBox Height="35" Padding="7,4" Margin="0,4,0,0"
                                                 Text="{Binding DraftColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanEditFields}"
                                                 AutomationProperties.Name="لون حالة التحضير بصيغة HEX"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="المعاينة لا تعدل البيانات. النظام يتحقق من عدم تكرار الرمز والاسم، ويحفظ تاريخ الحالات؛ ولا يسمح بتعطيل الحالة الافتراضية للتحضير التلقائي."
                                           Foreground="{DynamicResource NativeSecondary}" TextWrapping="Wrap"
                                           Margin="0,8,0,8"/>
                                <TextBlock Text="{Binding ReviewNote}" Foreground="{DynamicResource NativeText}"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           Visibility="{Binding IsReviewing, Converter={StaticResource StatusVisible}}"/>
                                <StackPanel Visibility="{Binding IsDeactivating, Converter={StaticResource StatusVisible}}">
                                    <CheckBox IsChecked="{Binding DeactivationConfirmed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsReviewing}" Margin="0,9,0,4"
                                              AutomationProperties.Name="إقرار صريح بتعطيل الحالة مع الحفاظ على التاريخ">
                                        <TextBlock Text="أؤكد تعطيل هذه الحالة من الخيارات الجديدة، مع الاحتفاظ بسجلات الأيام السابقة."
                                                   TextWrapping="Wrap"/>
                                    </CheckBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="معاينة دون حفظ" Style="{StaticResource StatusButton}"
                                            Command="{Binding ReviewCommand}"
                                            AutomationProperties.Name="مراجعة تغيير الحالة دون حفظ"/>
                                    <Button Content="اعتماد بعد المراجعة"
                                            Style="{StaticResource StatusButton}"
                                            Command="{Binding ConfirmCommand}"
                                            AutomationProperties.Name="اعتماد إضافة أو تعديل أو تعطيل حالة مرة واحدة"/>
                                    <Button Content="إلغاء التعديل" Style="{StaticResource StatusButton}"
                                            Command="{Binding CancelDraftCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding CompletionNote}" Foreground="{DynamicResource NativeAccentText}"
                                   FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="عند فقدان رد الاعتماد، راجع قائمة الحالات وسجل العمليات أولا. لا تُكرر العملية تلقائيا."
                                   FontSize="12" Foreground="{DynamicResource NativeSecondary}" TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
