<UserControl x:Class="AlTamam.NativeDesktop.Views.NativePersonnelMutationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style x:Key="MutationButton" TargetType="Button">
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>
    <Grid Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhenTrue}}"
          Background="#B80F172A">
        <Border Background="#FFFFFF" BorderBrush="#CBD5E1"
                BorderThickness="1" CornerRadius="10" Padding="18"
                Width="590" MaxHeight="640"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Header}" Foreground="#0F2942"
                               FontWeight="Bold" FontSize="19"
                               VerticalAlignment="Center" DockPanel.Dock="Right"/>
                    <Button Content="إغلاق" Style="{StaticResource MutationButton}"
                            Command="{Binding CloseCommand}"
                            AutomationProperties.Name="إغلاق مراجعة إنشاء أو تعديل الفرد"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="أدخل البيانات ثم اضغط معاينة؛ لن يُحفظ شيء قبل تأكيد مستقل."
                                   TextWrapping="Wrap" Foreground="#475569"/>
                        <ProgressBar Height="5" IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}"/>
                        <TextBlock Text="{Binding Error}" Foreground="#BE123C"
                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,8,0,6"/>
                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <TextBlock Text="الاسم الكامل" FontWeight="Bold"
                                       Foreground="#0F2942" Margin="0,8,0,3"/>
                            <TextBox Text="{Binding FormName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="35" Padding="8,4"
                                     AutomationProperties.Name="اسم الفرد الكامل"/>
                            <TextBlock Text="الرقم (ع) — أربعة أرقام على الأقل"
                                       FontWeight="Bold" Foreground="#0F2942" Margin="0,8,0,3"/>
                            <TextBox Text="{Binding FormNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="35" Padding="8,4"
                                     FlowDirection="LeftToRight"
                                     AutomationProperties.Name="الرقم العسكري الثابت"/>
                            <StackPanel Visibility="{Binding IsCreate, Converter={StaticResource VisibleWhenTrue}}">
                                <TextBlock Text="الموقع عند الإضافة" FontWeight="Bold"
                                           Foreground="#0F2942" Margin="0,8,0,3"/>
                                <ComboBox ItemsSource="{Binding SiteOptions}"
                                          DisplayMemberPath="Name" SelectedValuePath="SiteId"
                                          SelectedValue="{Binding FormSiteId, Mode=TwoWay}"
                                          Height="35" Width="220" HorizontalAlignment="Right"
                                          AutomationProperties.Name="الموقع المصرح به لإضافة الفرد"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsEdit, Converter={StaticResource VisibleWhenTrue}}">
                                <TextBlock Text="سبب تصحيح الاسم أو الرقم"
                                           FontWeight="Bold" Foreground="#0F2942" Margin="0,8,0,3"/>
                                <TextBox Text="{Binding FormReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="55" Padding="8,4" TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         AutomationProperties.Name="سبب تعديل الهوية لسجل العمليات"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="معاينة والتحقق من الهوية"
                                Style="{StaticResource MutationButton}"
                                Margin="0,12,0,0" Command="{Binding PreviewCommand}"
                                AutomationProperties.Name="معاينة دون تعديل بيانات الفرد"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0"
                                BorderThickness="1" CornerRadius="6"
                                Padding="12" Margin="0,8,0,8"
                                Visibility="{Binding HasPreview, Converter={StaticResource VisibleWhenTrue}}">
                            <StackPanel>
                                <TextBlock Text="مراجعة النتيجة المعتمدة" FontWeight="Bold"
                                           Foreground="#0F2942" Margin="0,0,0,6"/>
                                <TextBlock Text="الاسم السابق:" FontWeight="SemiBold"
                                           Visibility="{Binding IsEdit, Converter={StaticResource VisibleWhenTrue}}"/>
                                <TextBlock Text="{Binding Preview.OldName}" Foreground="#475569"/>
                                <TextBlock Text="الرقم (ع) السابق:"
                                           Visibility="{Binding IsEdit, Converter={StaticResource VisibleWhenTrue}}"/>
                                <TextBlock Text="{Binding Preview.OldNumber}" Foreground="#475569"/>
                                <TextBlock Text="الاسم الجديد:" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Preview.Draft.Name}" Foreground="#0F2942"/>
                                <TextBlock Text="الرقم (ع) المعتمد:" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Preview.CanonicalNumber}"
                                           FlowDirection="LeftToRight" HorizontalAlignment="Right"
                                           Foreground="#0F2942"/>
                                <TextBlock Text="تاريخ السريان:" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Preview.EffectiveLocalDate}"
                                           FlowDirection="LeftToRight" HorizontalAlignment="Right"
                                           Foreground="#0F2942"/>
                                <TextBlock Text="{Binding ConfirmationNote}"
                                           TextWrapping="Wrap" Foreground="#475569"
                                           Margin="0,8,0,2"/>
                            </StackPanel>
                        </Border>
                        <Button Content="تأكيد واعتماد حفظ الفرد"
                                Style="{StaticResource MutationButton}"
                                Command="{Binding ConfirmCommand}"
                                AutomationProperties.Name="تأكيد عملية إضافة أو تعديل الفرد بعد المعاينة"/>
                        <TextBlock Text="{Binding CompletionNote}" Foreground="#0D9488"
                                   FontWeight="Bold" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="تحذير: في حال انقطاع نتيجة الحفظ، راجع سجل الأفراد والعمليات. لن تُعاد العملية تلقائيا."
                                   Foreground="#64748B" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
