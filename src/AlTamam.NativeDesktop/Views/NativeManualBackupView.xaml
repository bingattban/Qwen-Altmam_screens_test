<UserControl x:Class="AlTamam.NativeDesktop.Views.NativeManualBackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ShowIfTrue"/>
    </UserControl.Resources>
    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="6">
        <StackPanel>
            <TextBlock Text="النسخ الاحتياطي اليدوي المشفر" FontSize="18" FontWeight="Bold" Foreground="#123752"/>
            <TextBlock Text="حفظ نسخة محلية والتحقق منها دون تعديل سجلات الحضور أو استعادة البيانات." TextWrapping="Wrap" Margin="0,5"/>
            <WrapPanel>
                <Button Content="اختيار مجلد الحفظ" Click="OnChooseFolder" IsEnabled="{Binding CanOpenBackup}" Padding="12,6" Margin="4"/>
                <Button Content="إنشاء نسخة احتياطية" Command="{Binding OpenManualBackupCommand}" Padding="12,6" Margin="4"/>
            </WrapPanel>
            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F1F5F9" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding Backup.IsOpen, Converter={StaticResource ShowIfTrue}}">
                <StackPanel>
                    <TextBlock Text="{Binding Backup.ReviewTitle}" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="{Binding Backup.EffectLabel}" TextWrapping="Wrap" Margin="0,6"/>
                    <TextBlock Text="المجلد المحدد" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Backup.Directory}" FlowDirection="LeftToRight" TextWrapping="Wrap" Margin="0,4"/>
                    <Button Content="تأكيد التنفيذ" Command="{Binding Backup.ConfirmCommand}" Padding="12,6" Margin="0,6" HorizontalAlignment="Right"/>
                    <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding Backup.IsBusy, Converter={StaticResource ShowIfTrue}}"/>
                    <TextBlock Text="{Binding Backup.Error}" Foreground="#BE123C" TextWrapping="Wrap" Margin="0,6"/>
                    <TextBlock Text="{Binding Backup.CompletionMessage}" Foreground="#166534" FontWeight="Bold" TextWrapping="Wrap"/>
                    <StackPanel Visibility="{Binding Backup.HasReceipt, Converter={StaticResource ShowIfTrue}}">
                        <TextBlock Text="معرف النسخة" FontWeight="SemiBold" Margin="0,6,0,2"/>
                        <TextBlock Text="{Binding Backup.Receipt.BackupId}" TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                        <TextBlock Text="مسار الملف" FontWeight="SemiBold" Margin="0,6,0,2"/>
                        <TextBlock Text="{Binding Backup.Receipt.Path}" TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                        <TextBlock Text="حجم الملف بالبايت" FontWeight="SemiBold" Margin="0,6,0,2"/>
                        <TextBlock Text="{Binding Backup.Receipt.FileSize}"/>
                        <TextBlock Text="بصمة SHA-256" FontWeight="SemiBold" Margin="0,6,0,2"/>
                        <TextBox Text="{Binding Backup.Receipt.Sha256, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <Button Content="إغلاق المراجعة" Command="{Binding CloseBackupCommand}" Padding="12,6" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
