<UserControl x:Class="AlTamam.NativeDesktop.Views.NativeSeparationArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="SeparationArchiveVisible"/>
        <Style x:Key="SeparationArchiveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource NativeAccentFill}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#C80F172A"
          Visibility="{Binding IsOpen, Converter={StaticResource SeparationArchiveVisible}}">
        <Border Background="White" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                CornerRadius="9" Padding="14" Margin="16" MaxWidth="1100"
                HorizontalAlignment="Center" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button Content="إغلاق الأرشيف" DockPanel.Dock="Left"
                            Style="{StaticResource SeparationArchiveButton}"
                            Command="{Binding CloseCommand}"/>
                    <TextBlock Text="أرشيف الفصل — سجلات تاريخية للقراءة فقط"
                               Foreground="{DynamicResource NativeText}" FontSize="20"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <StackPanel Margin="4">
                        <TextBlock Text="الموقع المصدر" Foreground="{DynamicResource NativeText}" FontWeight="SemiBold"/>
                        <ComboBox Width="190" Height="34" Margin="0,3,0,0"
                                  ItemsSource="{Binding SiteOptions}"
                                  DisplayMemberPath="Name" SelectedValuePath="SiteId"
                                  SelectedValue="{Binding SelectedSiteId, Mode=OneWay}"
                                  SelectionChanged="OnSiteChanged"
                                  AutomationProperties.Name="تصفية سجل الفصل حسب الموقع الأصلي"/>
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="اسم الفرد أو الرقم (ع)" Foreground="{DynamicResource NativeText}"
                                   FontWeight="SemiBold"/>
                        <TextBox Width="200" Height="34" Margin="0,3,0,0"
                                 Padding="8,4"
                                 Text="{Binding SearchDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="بحث أرشيف الفصل"/>
                    </StackPanel>
                    <Button Content="بحث" VerticalAlignment="Bottom"
                            Style="{StaticResource SeparationArchiveButton}"
                            Command="{Binding SearchCommand}"/>
                    <Button Content="تحديث" VerticalAlignment="Bottom"
                            Style="{StaticResource SeparationArchiveButton}"
                            Command="{Binding RefreshCommand}"/>
                    <Button Content="تفاصيل الفصل المحدد" VerticalAlignment="Bottom"
                            Style="{StaticResource SeparationArchiveButton}"
                            Command="{Binding DetailsCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=SeparationArchiveGrid}"
                            AutomationProperties.Name="عرض تفاصيل الفصل التاريخية"/>
                </WrapPanel>
                <StackPanel Grid.Row="2" Margin="0,0,0,5">
                    <TextBlock Text="{Binding LoadError}" Foreground="{DynamicResource NativeDangerText}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding DetailError}" Foreground="{DynamicResource NativeDangerText}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar Height="4" IsIndeterminate="True" Foreground="{DynamicResource NativeAccentText}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource SeparationArchiveVisible}}"/>
                </StackPanel>
                <DataGrid x:Name="SeparationArchiveGrid" Grid.Row="3"
                          ItemsSource="{Binding Rows}"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserSortColumns="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeight="35"
                          ColumnHeaderHeight="38" MinHeight="170"
                          AlternatingRowBackground="#F8FAFC"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="110"/>
                        <DataGridTextColumn Header="اسم الفرد وقت الفصل" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="*"/>
                        <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="2*"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding EffectiveDate}" Width="110"/>
                        <DataGridTextColumn Header="نفذ العملية" Binding="{Binding ActorDisplay}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="4" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PageLabel}"
                               Foreground="{DynamicResource NativeMuted}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="السابق" Style="{StaticResource SeparationArchiveButton}"
                                Command="{Binding PreviousPageCommand}"/>
                        <Button Content="التالي" Style="{StaticResource SeparationArchiveButton}"
                                Command="{Binding NextPageCommand}"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.RowSpan="5" Panel.ZIndex="2" Background="#C80F172A"
                        Visibility="{Binding HasDetail, Converter={StaticResource SeparationArchiveVisible}}">
                    <Border Background="White" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                            CornerRadius="8" Width="560" MaxHeight="530"
                            Padding="18" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="تفاصيل الفصل الأصلية — قراءة فقط"
                                           Foreground="{DynamicResource NativeText}" FontSize="18"
                                           FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBlock Text="الاسم التاريخي" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedDetail.Name}" Foreground="{DynamicResource NativeText}"/>
                                <TextBlock Text="الرقم (ع)" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SelectedDetail.ServiceNumberA}"/>
                                <TextBlock Text="الموقع وقت الفصل" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SelectedDetail.SiteName}"/>
                                <TextBlock Text="سبب الفصل المسجل" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SelectedDetail.Reason}" TextWrapping="Wrap"/>
                                <TextBlock Text="تاريخ الفصل" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SelectedDetail.EffectiveDate}"/>
                                <TextBlock Text="تاريخ اعتماد العملية (UTC)" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SelectedDetail.CommittedAtUtc}"
                                           FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                <TextBlock Text="معرف المنفذ" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SelectedDetail.ActorUserId}"/>
                                <Button Content="إغلاق التفاصيل" HorizontalAlignment="Left"
                                        Style="{StaticResource SeparationArchiveButton}"
                                        Command="{Binding CloseDetailsCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
