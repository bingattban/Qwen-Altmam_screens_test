<UserControl x:Class="AlTamam.NativeDesktop.Views.NativeDailyAttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AlTamam.NativeDesktop.Views"
             FlowDirection="RightToLeft" FontFamily="Segoe UI" Background="#FFFFFF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue"/>
        <Style x:Key="DailyButton" TargetType="Button">
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="التمام اليومي" FontSize="22" FontWeight="Bold"
                           Foreground="#0F2942" DockPanel.Dock="Right"/>
                <TextBlock Text="{Binding BusinessDateLabel}" FlowDirection="LeftToRight"
                           Foreground="#475569" VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" IsEnabled="{Binding CanChangeRosterScope}" Background="#FFFFFF" BorderBrush="#E2E8F0"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <WrapPanel>
                <StackPanel Margin="4" MinWidth="145">
                    <TextBlock Text="الموقع" FontWeight="SemiBold" Foreground="#0F2942"/>
                    <ComboBox Width="160" Height="34" Margin="0,4,0,0"
                              ItemsSource="{Binding SiteOptions}"
                              DisplayMemberPath="Name" SelectedValuePath="SiteId"
                              SelectedValue="{Binding SelectedSiteId, Mode=OneWay}"
                              SelectionChanged="OnSiteChanged"
                              AutomationProperties.Name="تصفية التمام حسب الموقع"/>
                </StackPanel>
                <StackPanel Margin="4" MinWidth="145">
                    <TextBlock Text="الحالة" FontWeight="SemiBold" Foreground="#0F2942"/>
                    <ComboBox Width="175" Height="34" Margin="0,4,0,0"
                              ItemsSource="{Binding StatusOptions}"
                              DisplayMemberPath="DisplayName" SelectedValuePath="StatusId"
                              SelectedValue="{Binding SelectedStatusId, Mode=OneWay}"
                              SelectionChanged="OnStatusChanged"
                              AutomationProperties.Name="تصفية التمام حسب الحالة"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="البحث بالاسم أو الرقم (ع)" FontWeight="SemiBold" Foreground="#0F2942"/>
                    <TextBox Width="195" Height="34" Margin="0,4,0,0" Padding="8,4"
                             Text="{Binding SearchDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="بحث في كشف التمام اليومي"/>
                </StackPanel>
                <Button Content="بحث" Style="{StaticResource DailyButton}"
                        VerticalAlignment="Bottom" Command="{Binding SearchCommand}"/>
                <Button Content="مسح" Style="{StaticResource DailyButton}"
                        VerticalAlignment="Bottom" Command="{Binding ClearSearchCommand}"/>
                <Button Content="تحديث" Style="{StaticResource DailyButton}"
                        VerticalAlignment="Bottom" Command="{Binding RefreshCommand}"/>
                <Button Content="معاينة تغيير حالة الفرد المحدد"
                        Style="{StaticResource DailyButton}" VerticalAlignment="Bottom"
                        Command="{Binding ReviewPersonCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=DailyGrid}"
                        AutomationProperties.Name="معاينة تغيير حالة فرد من الكشف اليومي"/>
                <Button Content="تحديد كل الصفحة" Style="{StaticResource DailyButton}"
                        VerticalAlignment="Bottom" Click="OnSelectVisiblePage"
                        AutomationProperties.Name="تحديد جميع الأفراد المعروضين بحد أقصى مئة فرد"/>
                <Button Content="مسح التحديد" Style="{StaticResource DailyButton}"
                        VerticalAlignment="Bottom" Click="OnClearVisibleSelection"
                        AutomationProperties.Name="إلغاء تحديد أفراد التمام اليومي"/>
                <Button Content="معاينة تغيير حالة المحددين"
                        Style="{StaticResource DailyButton}" VerticalAlignment="Bottom"
                        Command="{Binding ReviewSelectedCommand}"
                        AutomationProperties.Name="معاينة تغيير الحالة الجماعي بعد اختيار الأفراد"/>
            </WrapPanel>
        </Border>
        <StackPanel Grid.Row="2" Margin="4,2,4,8">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#475569"/>
            <TextBlock Text="أثناء المراجعة أو الاعتماد يبقى نطاق الكشف ثابتا؛ بعد الإغلاق يمكنك تغيير البحث أو الموقع." TextWrapping="Wrap" Foreground="#64748B"/>
            <TextBlock Text="{Binding SelectedLabel}" FontWeight="SemiBold" Foreground="#0F2942"/>
            <TextBlock Text="{Binding SelectionError}" TextWrapping="Wrap" Foreground="#BE123C"
                       AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Foreground="#BE123C"
                       FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar Height="4" IsIndeterminate="True" Foreground="#0D9488"
                         Visibility="{Binding IsLoading, Converter={StaticResource VisibleIfTrue}}"/>
        </StackPanel>
        <DataGrid x:Name="DailyGrid" Grid.Row="3" ItemsSource="{Binding Rows}"
                  IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" SelectionMode="Extended"
                  SelectionUnit="FullRow" SelectionChanged="OnDailySelectionChanged"
                  IsEnabled="{Binding CanChangeRosterScope}"
                  HeadersVisibility="Column" RowHeight="35" ColumnHeaderHeight="38"
                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFC"
                  BorderBrush="#CBD5E1" BorderThickness="1" MinHeight="190">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الرقم" Binding="{Binding RowNumber}" Width="62"/>
                <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="95"/>
                <DataGridTextColumn Header="الرتبة" Binding="{Binding Rank}" Width="95"/>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="*"/>
                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,8,0,0" IsEnabled="{Binding CanChangeRosterScope}">
            <TextBlock Text="{Binding PageLabel}" DockPanel.Dock="Right" Foreground="#475569"
                       VerticalAlignment="Center" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="السابق" Command="{Binding PreviousPageCommand}" Style="{StaticResource DailyButton}"/>
                <Button Content="التالي" Command="{Binding NextPageCommand}" Style="{StaticResource DailyButton}"/>
            </StackPanel>
        </DockPanel>
        <!-- Shared server-authorized preview and explicit audit commit;
             the underlying daily grid remains non-editable. -->
        <views:NativeAttendanceReviewView Grid.RowSpan="5"
                                          DataContext="{Binding Review}"
                                          Panel.ZIndex="103"/>
    </Grid>
</UserControl>
