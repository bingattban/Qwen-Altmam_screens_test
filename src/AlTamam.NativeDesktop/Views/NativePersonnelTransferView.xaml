<UserControl x:Class="AlTamam.NativeDesktop.Views.NativePersonnelTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="TransferVisible"/>
        <Style x:Key="TransferButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource NativeAccentFill}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>
    <Grid Visibility="{Binding IsOpen, Converter={StaticResource TransferVisible}}"
          Background="#B80F172A">
        <Border Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeBorder}"
                BorderThickness="1" CornerRadius="10" Padding="18"
                Width="585" MaxHeight="610"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Header}" FontSize="19"
                               FontWeight="Bold" Foreground="{DynamicResource NativeText}"
                               VerticalAlignment="Center" DockPanel.Dock="Right"/>
                    <Button Content="إغلاق" Command="{Binding CloseCommand}"
                            Style="{StaticResource TransferButton}"
                            AutomationProperties.Name="إغلاق مراجعة النقل"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="المصدر: الفرد المحدد من كشف موقع محدد. لا يمكن النقل من عرض جميع المواقع."
                                   Foreground="{DynamicResource NativeMuted}" TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <ProgressBar Height="5" IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource TransferVisible}}"/>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NativeDangerText}"
                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Grid Margin="0,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الفرد" FontWeight="Bold"
                                           Foreground="{DynamicResource NativeSecondary}"/>
                                <TextBlock Text="{Binding SelectedPersonName}"
                                           Foreground="{DynamicResource NativeText}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedPersonNumber}"
                                           Foreground="{DynamicResource NativeMuted}" FlowDirection="LeftToRight"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="الموقع المصدر" FontWeight="Bold"
                                           Foreground="{DynamicResource NativeSecondary}"/>
                                <TextBlock Text="{Binding SourceSiteName}"
                                           Foreground="{DynamicResource NativeText}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <StackPanel Visibility="{Binding IsInternal, Converter={StaticResource TransferVisible}}">
                                <TextBlock Text="الموقع المنقول إليه" FontWeight="Bold"
                                           Foreground="{DynamicResource NativeText}" Margin="0,8,0,3"/>
                                <ComboBox Height="35" MinWidth="210" HorizontalAlignment="Right"
                                          ItemsSource="{Binding SiteOptions}"
                                          DisplayMemberPath="Name" SelectedValuePath="SiteId"
                                          SelectedValue="{Binding FormDestinationSiteId, Mode=TwoWay}"
                                          AutomationProperties.Name="اختيار الموقع الداخلي المستهدف"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsExternal, Converter={StaticResource TransferVisible}}">
                                <TextBlock Text="اسم الجهة الخارجية" FontWeight="Bold"
                                           Foreground="{DynamicResource NativeText}" Margin="0,8,0,3"/>
                                <TextBox Height="35" Padding="8,4"
                                         Text="{Binding FormExternalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="جهة النقل الخارجية"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="معاينة النقل دون حفظ"
                                Style="{StaticResource TransferButton}"
                                Command="{Binding PreviewCommand}"
                                AutomationProperties.Name="التحقق من حركة النقل الأصلية دون حفظ"/>
                        <Border BorderBrush="{DynamicResource NativeSubtleBorder}" BorderThickness="1"
                                Background="{DynamicResource NativeSubtle}" CornerRadius="6"
                                Margin="0,8" Padding="12"
                                Visibility="{Binding HasPreview, Converter={StaticResource TransferVisible}}">
                            <StackPanel>
                                <TextBlock Text="نتيجة المعاينة المعتمدة" FontWeight="Bold"
                                           Foreground="{DynamicResource NativeText}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ReviewMessage}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}"/>
                                <TextBlock Text="الجهة الهدف" FontWeight="Bold"
                                           Foreground="{DynamicResource NativeSecondary}" Margin="0,8,0,3"/>
                                <TextBlock Text="{Binding Preview.DestinationName}"
                                           Foreground="{DynamicResource NativeText}"/>
                                <TextBlock Text="تاريخ الحركة" FontWeight="Bold"
                                           Foreground="{DynamicResource NativeSecondary}" Margin="0,8,0,3"/>
                                <TextBlock Text="{Binding Preview.BusinessDate}"
                                           FlowDirection="LeftToRight"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource NativeText}"/>
                            </StackPanel>
                        </Border>
                        <Button Content="تأكيد واعتماد النقل"
                                Style="{StaticResource TransferButton}"
                                Command="{Binding ConfirmCommand}"
                                AutomationProperties.Name="تأكيد حفظ حركة النقل بعد المعاينة"/>
                        <TextBlock Text="{Binding CompletionMessage}" Foreground="{DynamicResource NativeAccentText}"
                                   FontWeight="Bold" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="تنبيه: النقل يتم لتاريخ اليوم فقط، ويُرفض تكرار الحركة لنفس الفرد خلال اليوم. عند فقدان نتيجة الاعتماد، تحقق من سجل النقل والعمليات قبل أي محاولة أخرى."
                                   Foreground="{DynamicResource NativeSecondary}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
