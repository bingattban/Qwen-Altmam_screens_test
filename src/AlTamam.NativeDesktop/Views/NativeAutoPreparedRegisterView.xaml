<UserControl x:Class="AlTamam.NativeDesktop.Views.NativeAutoPreparedRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AlTamam.NativeDesktop.Views"
             FlowDirection="RightToLeft" FontFamily="Segoe UI"
             AutomationProperties.Name="سجل المحضّرين تلقائياً">
    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style x:Key="AutoButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource NativeAccentFill}"/>
            <Setter Property="Foreground" Value="{DynamicResource NativeOnStrong}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AutoNeutralButton" TargetType="Button" BasedOn="{StaticResource AutoButton}">
            <Setter Property="Background" Value="{DynamicResource NativeSubtle}"/>
            <Setter Property="Foreground" Value="{DynamicResource NativeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NativeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>
    <!-- This is a genuine native WPF overlay, scoped to the Dashboard.
         Read-only until the separate audited preview/commit UI is migrated. -->
    <Grid Background="#B30F2942">
        <Border Background="{DynamicResource NativeSurface}" CornerRadius="12" BorderBrush="{DynamicResource NativeBorder}"
                BorderThickness="1" Padding="18" Margin="12"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                MaxWidth="1100" MaxHeight="650" MinHeight="400"
                KeyboardNavigation.TabNavigation="Cycle">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Review.IsOpen}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button x:Name="CloseButton" Content="إغلاق" DockPanel.Dock="Left"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource AutoNeutralButton}"
                            AutomationProperties.Name="إغلاق سجل المحضّرين تلقائياً"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource NativeText}"
                                   FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="سجل التحضير التلقائي المحفوظ — قراءة محمية من قاعدة البيانات"
                                   Foreground="{DynamicResource NativeMuted}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource NativeCanvas}" BorderBrush="{DynamicResource NativeBorder}"
                        BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,13">
                    <TextBlock Text="هذا السجل للعرض والبحث فقط. لتغيير حالات الأفراد حدد الأسماء ثم افتح نافذة المراجعة، واختر الحالة وتاريخي البداية والنهاية عند الإجازة أو الإذن، وراجع البيانات ثم أكد الاعتماد."
                               Foreground="{DynamicResource NativeText}" TextWrapping="Wrap" FontSize="13"/>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="بحث بالاسم أو الرقم (ع)" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{DynamicResource NativeText}" Margin="0,0,10,0"/>
                        <TextBox Width="245" Height="38" MaxLength="101"
                                 Padding="10,7" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="بحث في سجل المحضّرين تلقائيا"
                                 Text="{Binding SearchDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="بحث" Command="{Binding SearchCommand}"
                                Style="{StaticResource AutoButton}"/>
                        <Button Content="مسح البحث" Command="{Binding ClearSearchCommand}"
                                Style="{StaticResource AutoNeutralButton}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,3" VerticalAlignment="Center">
                        <Button Content="تحديد الصفحة" Command="{Binding SelectVisiblePageCommand}"
                                Style="{StaticResource AutoNeutralButton}"/>
                        <Button Content="إلغاء التحديد" Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource AutoNeutralButton}"/>
                        <Button Content="معاينة تغيير المحددين" Command="{Binding ReviewSelectedCommand}"
                                Style="{StaticResource AutoButton}"/>
                        <TextBlock Text="{Binding SelectedLabel}" Foreground="{DynamicResource NativeText}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding LoadError}" Foreground="{DynamicResource NativeDangerText}"
                               FontSize="13" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" Margin="3,5,0,2"/>
                    <ProgressBar Height="4" IsIndeterminate="True" Foreground="{DynamicResource NativeAccentText}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhenTrue}}"/>
                </StackPanel>
                <DataGrid x:Name="RegisterGrid" Grid.Row="3"
                          ItemsSource="{Binding Rows}" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" AutoGenerateColumns="False"
                          HeadersVisibility="Column" FlowDirection="RightToLeft"
                          AlternatingRowBackground="{DynamicResource NativeSubtle}"
                          BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                          GridLinesVisibility="Horizontal" RowHeight="36"
                          ColumnHeaderHeight="39" MinHeight="210">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="تحديد" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Checked="OnRegisterCheckboxChanged"
                                              Unchecked="OnRegisterCheckboxChanged"
                                              AutomationProperties.Name="تحديد الفرد لتعديل الحالة"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding RowNumber}" Width="60"/>
                        <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="105"/>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="1.5*"/>
                        <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="*"/>
                        <DataGridTextColumn Header="تاريخ التحضير" Binding="{Binding SavedBusinessDate}" Width="120"/>
                        <DataGridTextColumn Header="مصدر التحضير" Binding="{Binding AutoSource}" Width="140"/>
                        <DataGridTextColumn Header="وقت الاعتماد UTC" Binding="{Binding CommittedAtUtc}" Width="165"/>
                        <DataGridTextColumn Header="الحالة المحفوظة" Binding="{Binding StatusName}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="4" Margin="0,12,0,0">
                    <TextBlock Text="{Binding PageLabel}" Foreground="{DynamicResource NativeMuted}"
                               DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="السابق" Command="{Binding PreviousPageCommand}"
                                Style="{StaticResource AutoNeutralButton}"/>
                        <Button Content="التالي" Command="{Binding NextPageCommand}"
                                Style="{StaticResource AutoButton}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
        <!-- A separate native, keyboard-contained approval stage. The
             read-only register beneath is disabled for the duration. -->
        <views:NativeAttendanceReviewView DataContext="{Binding Review}" Panel.ZIndex="103"/>
    </Grid>
</UserControl>
