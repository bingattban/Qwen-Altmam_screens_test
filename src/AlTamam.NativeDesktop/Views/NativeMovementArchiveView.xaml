<UserControl x:Class="AlTamam.NativeDesktop.Views.NativeMovementArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ArchiveVisible"/>
        <Style x:Key="ArchiveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource NativeAccentFill}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#C80F172A"
          Visibility="{Binding IsOpen, Converter={StaticResource ArchiveVisible}}">
        <Border Background="White" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                CornerRadius="9" Padding="14" Margin="16" MaxWidth="1080"
                HorizontalAlignment="Center" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button Content="إغلاق الأرشيف" DockPanel.Dock="Left"
                            Style="{StaticResource ArchiveButton}"
                            Command="{Binding CloseCommand}"/>
                    <TextBlock Text="أرشيف التنقلات والعودة — قراءة فقط"
                               Foreground="{DynamicResource NativeText}" FontSize="20"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <StackPanel Margin="4">
                        <TextBlock Text="نوع الحركة" Foreground="{DynamicResource NativeText}"
                                   FontWeight="SemiBold"/>
                        <ComboBox Width="190" Height="34" Margin="0,3,0,0"
                                  ItemsSource="{Binding TypeOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedType, Mode=OneWay}"
                                  SelectionChanged="OnTypeChanged"
                                  AutomationProperties.Name="تصفية أرشيف التنقلات حسب النوع"/>
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="الاسم أو الرقم (ع)" Foreground="{DynamicResource NativeText}"
                                   FontWeight="SemiBold"/>
                        <TextBox Width="200" Height="34" Margin="0,3,0,0"
                                 Padding="8,4"
                                 Text="{Binding SearchDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="بحث أرشيف التنقلات"/>
                    </StackPanel>
                    <Button Content="بحث" VerticalAlignment="Bottom"
                            Style="{StaticResource ArchiveButton}"
                            Command="{Binding SearchCommand}"/>
                    <Button Content="تحديث" VerticalAlignment="Bottom"
                            Style="{StaticResource ArchiveButton}"
                            Command="{Binding RefreshCommand}"/>
                    <Button Content="تفاصيل الحركة المحددة" VerticalAlignment="Bottom"
                            Style="{StaticResource ArchiveButton}"
                            Command="{Binding DetailsCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=MovementArchiveGrid}"
                            AutomationProperties.Name="عرض تفاصيل الحركة التاريخية"/>
                </WrapPanel>
                <StackPanel Grid.Row="2" Margin="0,0,0,5">
                    <TextBlock Text="{Binding LoadError}" Foreground="{DynamicResource NativeDangerText}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding DetailError}" Foreground="{DynamicResource NativeDangerText}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar Height="4" IsIndeterminate="True"
                                 Foreground="{DynamicResource NativeAccentText}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource ArchiveVisible}}"/>
                </StackPanel>
                <DataGrid x:Name="MovementArchiveGrid" Grid.Row="3"
                          ItemsSource="{Binding Rows}"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserSortColumns="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeight="34"
                          ColumnHeaderHeight="37" MinHeight="175"
                          AlternatingRowBackground="#F8FAFC"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="105"/>
                        <DataGridTextColumn Header="الاسم التاريخي" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="75"/>
                        <DataGridTextColumn Header="الموقع المصدر" Binding="{Binding SourceSite}" Width="*"/>
                        <DataGridTextColumn Header="الجهة المستقبلة" Binding="{Binding Destination}" Width="*"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding EffectiveDate}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="4" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PageLabel}"
                               Foreground="{DynamicResource NativeMuted}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="السابق" Style="{StaticResource ArchiveButton}"
                                Command="{Binding PreviousPageCommand}"/>
                        <Button Content="التالي" Style="{StaticResource ArchiveButton}"
                                Command="{Binding NextPageCommand}"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.RowSpan="5" Panel.ZIndex="2" Background="#C80F172A"
                        Visibility="{Binding HasDetail, Converter={StaticResource ArchiveVisible}}">
                    <Border Background="White" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                            CornerRadius="8" Width="510" MaxHeight="490"
                            Padding="18" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="تفاصيل الحركة المسجلة — قراءة فقط"
                                       Foreground="{DynamicResource NativeText}" FontSize="18"
                                       FontWeight="Bold" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding SelectedDetail.Name}"
                                       Foreground="{DynamicResource NativeText}" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="{Binding SelectedDetail.ServiceNumberA}"/>
                            <TextBlock Text="{Binding SelectedDetail.Type}"/>
                            <TextBlock Text="{Binding SelectedDetail.SourceSite}"/>
                            <TextBlock Text="{Binding SelectedDetail.Destination}"/>
                            <TextBlock Text="{Binding SelectedDetail.EffectiveDate}"/>
                            <TextBlock Text="{Binding SelectedDetail.CommittedAtUtc}"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            <TextBlock Text="نفذ الحركة:" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding SelectedDetail.ActorUsername}"/>
                            <Button Content="إغلاق التفاصيل" HorizontalAlignment="Left"
                                    Style="{StaticResource ArchiveButton}"
                                    Command="{Binding CloseDetailsCommand}"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
