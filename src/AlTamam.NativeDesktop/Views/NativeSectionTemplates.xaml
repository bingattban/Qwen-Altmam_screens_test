<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:AlTamam.NativePresentation;assembly=AlTamam.NativePresentation"
                    xmlns:views="clr-namespace:AlTamam.NativeDesktop.Views">
    <Style x:Key="HeaderStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="#123752" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="StatusStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#845B12" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,22" />
    </Style>
    <!-- Native authenticated dashboard + daily roster read-only SQLCipher.
         Other section templates remain nonoperational preview routes. -->
    <DataTemplate DataType="{x:Type vm:DashboardPageViewModel}">
        <views:NativeDashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DailyAttendancePageViewModel}">
        <views:NativeDailyAttendanceView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MonthlyAttendancePageViewModel}">
        <views:NativeMonthlyAttendanceView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AdministrationPageViewModel}">
        <views:NativePersonnelDirectoryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportsPageViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderStyle}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusStyle}" />
            <StackPanel IsEnabled="False">
                <TextBlock Text="بحث التقارير" Margin="0,0,0,8" />
                <TextBox Height="35" Margin="0,0,0,18" />
                <Button Content="تصدير Excel" HorizontalAlignment="Left" Width="150" Padding="10" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderStyle}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusStyle}" />
            <UniformGrid Columns="2" IsEnabled="False">
                <Button Content="النسخ الاحتياطي" Height="55" Margin="6" />
                <Button Content="استعادة نسخة احتياطية" Height="55" Margin="6" />
                <Button Content="المظهر" Height="55" Margin="6" />
                <Button Content="حول البرنامج" Height="55" Margin="6" />
            </UniformGrid>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
