<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:AlTamam.NativePresentation;assembly=AlTamam.NativePresentation"
                    xmlns:views="clr-namespace:AlTamam.NativeDesktop.Views">
    <BooleanToVisibilityConverter x:Key="VisibilityIfTrue"/>
    <Style x:Key="HeaderStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource NativeHeading}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="StatusStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource NativeWarningText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,22" />
    </Style>
    <!-- Native authenticated dashboard + daily roster read-only SQLCipher.
         Other section templates remain nonoperational preview routes. -->
    <DataTemplate DataType="{x:Type vm:DashboardPageViewModel}">
        <views:NativeDashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DailyAttendancePageViewModel}">
        <views:NativeDailyAttendanceView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MonthlyAttendancePageViewModel}">
        <views:NativeMonthlyAttendanceView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AdministrationPageViewModel}">
        <views:NativePersonnelDirectoryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NativeAuditPageViewModel}">
        <Grid FlowDirection="RightToLeft">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderStyle}"/>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}"/>
                <Button Content="أرشيف القيود المعدلة والمخفية" Command="{Binding OpenHistoryCommand}" Visibility="{Binding CanOpenHistory, Converter={StaticResource VisibilityIfTrue}}" Margin="0,6" Padding="10,5" HorizontalAlignment="Right"/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,8" IsEnabled="{Binding CanQuery}">
                <StackPanel Margin="4"><TextBlock Text="بحث عام"/>
                    <TextBox Width="145" MaxLength="200" Text="{Binding Term, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="بحث عام في سجل العمليات"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="منفذ العملية"/>
                    <TextBox Width="125" MaxLength="200" Text="{Binding Actor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="منفذ العملية"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="المستهدف"/>
                    <TextBox Width="125" MaxLength="200" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="المستهدف"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="رمز العملية"/>
                    <TextBox Width="125" MaxLength="200" Text="{Binding Operation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="رمز العملية"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="من تاريخ (UTC)"/>
                    <TextBox Width="125" MaxLength="10" FlowDirection="LeftToRight" Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="من تاريخ YYYY-MM-DD"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="إلى تاريخ (UTC)"/>
                    <TextBox Width="125" MaxLength="10" FlowDirection="LeftToRight" Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="إلى تاريخ YYYY-MM-DD"/></StackPanel>
                <CheckBox Content="إظهار القيود المخفية" Margin="6" VerticalAlignment="Center"
                          Visibility="{Binding CanIncludeTombstoned, Converter={StaticResource VisibilityIfTrue}}"
                          IsChecked="{Binding IncludeTombstoned, Mode=TwoWay}"/>
                <Button Content="بحث" Command="{Binding SearchCommand}" Padding="12,5" Margin="4"/>
                <Button Content="تحديث" Command="{Binding RefreshCommand}" Padding="12,5" Margin="4"/>
                <Button Content="مسح الفلاتر" Command="{Binding ClearFiltersCommand}" Padding="12,5" Margin="4"/>
            </WrapPanel>
            <StackPanel Grid.Row="2">
                <TextBlock Text="التواريخ بصيغة YYYY-MM-DD؛ نطاق البحث حسب توقيت UTC للخدمة الأصلية." Foreground="{DynamicResource NativeMuted}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"/>
                <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityIfTrue}}"/>
            </StackPanel>
            <DataGrid Grid.Row="3" Margin="0,8" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.Name="كشف سجل العمليات للقراءة فقط">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الرقم" Binding="{Binding Sequence}" Width="55"/>
                    <DataGridTextColumn Header="العملية" Binding="{Binding OperationName}" Width="135"/>
                    <DataGridTextColumn Header="المنفذ" Binding="{Binding ActorDisplay}" Width="130"/>
                    <DataGridTextColumn Header="المستهدف" Binding="{Binding TargetDisplay}" Width="130"/>
                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="تاريخ التنفيذ UTC" Binding="{Binding ExecutedAtUtc}" Width="155"/>
                    <DataGridTextColumn Header="النتيجة" Binding="{Binding Outcome}" Width="90"/>
                    <DataGridCheckBoxColumn Header="مخفي" Binding="{Binding IsTombstoned, Mode=OneWay}" Width="60"/>
                    <DataGridTemplateColumn Header="التفاصيل" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="عرض" Padding="5,2"
                                        Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="عرض تفاصيل العملية"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="3" Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,8"
                    Visibility="{Binding IsDetailOpen, Converter={StaticResource VisibilityIfTrue}}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="إغلاق التفاصيل" Padding="10,5"
                                    Command="{Binding CloseDetailCommand}"/>
                            <TextBlock Text="تفاصيل العملية — الدليل الأصلي" FontWeight="Bold" FontSize="17"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <ProgressBar Height="4" IsIndeterminate="True"
                                     Visibility="{Binding IsDetailLoading, Converter={StaticResource VisibilityIfTrue}}"/>
                        <TextBlock Text="{Binding DetailError}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{Binding Detail.ChainStatus}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource NativeDangerText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Detail.ChainValid}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource NativeSuccessText}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="معرف القيد" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Detail.AuditEventId, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,7"/>
                            <TextBlock Text="العملية والمنفذ وقت التنفيذ" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Detail.OperationName}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DetailRow.ActorDisplay}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail.ActorUserId}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                            <TextBlock Text="المستهدف ومعرفه" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Detail.TargetDisplay}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail.TargetEntityId}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                            <TextBlock Text="تاريخ السريان وتاريخ التنفيذ UTC" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Detail.EffectiveLocalDate}"/>
                            <TextBlock Text="{Binding Detail.ExecutedAtUtc}" Margin="0,0,0,7"/>
                            <TextBlock Text="الوصف الظاهر في الكشف" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DetailRow.Description}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                            <TextBlock Text="الوصف الأصلي وسبب العملية" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Detail.RawDescription, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding Detail.Reason, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,2,0,7"/>
                            <TextBlock Text="القيمة السابقة" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Detail.OldValueDisplay, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,2,0,7"/>
                            <TextBlock Text="القيمة اللاحقة" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Detail.NewValueDisplay, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,2,0,7"/>
                            <TextBlock Text="بصمة القيد SHA-256" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Detail.EventHash, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight" TextWrapping="Wrap" Margin="0,2,0,7"/>
                            <TextBlock Text="بصمة القيد السابق" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Detail.PriorEventHash, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight" TextWrapping="Wrap" Margin="0,2,0,7"/>
                            <TextBlock Text="معرف الارتباط وإصدار العرض" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Detail.CorrelationId, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail.OverlayVersion}"/>
                            <Button Content="تاريخ تعديلات هذا القيد" Command="{Binding OpenEntryHistoryCommand}" Visibility="{Binding CanOpenEntryHistory, Converter={StaticResource VisibilityIfTrue}}" Padding="10,5" Margin="0,6" HorizontalAlignment="Right"/>
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Content="تعديل الوصف الظاهر" Command="{Binding OpenEditCommand}"
                                        Visibility="{Binding CanOpenEdit, Converter={StaticResource VisibilityIfTrue}}"
                                        Margin="4,8" Padding="12,6"/>
                                <Button Content="إخفاء القيد من العرض" Command="{Binding OpenHideCommand}"
                                        Visibility="{Binding CanOpenHide, Converter={StaticResource VisibilityIfTrue}}"
                                        Margin="4,8" Padding="12,6" Foreground="{DynamicResource NativeDangerText}"/>
                            </WrapPanel>
                            <Border Background="{DynamicResource NativeCanvas}" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="10" Margin="0,8"
                                    Visibility="{Binding Edit.IsOpen, Converter={StaticResource VisibilityIfTrue}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Edit.ReviewTitle}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="يبقى القيد الأصلي محفوظا. لا يعتمد أي تغيير قبل التأكيد." TextWrapping="Wrap" Margin="0,4"/>
                                    <StackPanel IsEnabled="{Binding Edit.CanEdit}">
                                        <StackPanel Visibility="{Binding Edit.ShowDescriptionEditor, Converter={StaticResource VisibilityIfTrue}}">
                                            <TextBlock Text="الوصف الجديد" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding Edit.Description, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="2000" TextWrapping="Wrap" MinHeight="44" Margin="0,3,0,8"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Edit.ReasonLabel}" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding Edit.Reason, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="400" TextWrapping="Wrap" MinHeight="36" Margin="0,3,0,8"/>
                                        <Button Content="{Binding Edit.PreviewLabel}" Command="{Binding Edit.PreviewCommand}" Padding="10,5" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding Edit.HasPreview, Converter={StaticResource VisibilityIfTrue}}" Margin="0,8">
                                        <TextBlock Text="قبل التعديل" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Edit.BeforeDescription}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Edit.AfterLabel}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Edit.Prepared.Description}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Edit.ReasonLabel}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Edit.Prepared.Reason}" TextWrapping="Wrap"/>
                                        <Button Content="{Binding Edit.ConfirmLabel}" Command="{Binding Edit.ConfirmCommand}"
                                                Padding="10,6" Margin="0,8,0,0" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding Edit.IsBusy, Converter={StaticResource VisibilityIfTrue}}"/>
                                    <TextBlock Text="{Binding Edit.Error}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Edit.CompletionMessage}" Foreground="{DynamicResource NativeSuccessText}" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <Button Content="إغلاق المراجعة" Command="{Binding CloseEditCommand}" Margin="0,8,0,0" Padding="10,5" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <DockPanel Grid.Row="4">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="السابق" Command="{Binding PreviousCommand}" Margin="4" Padding="12,5"/>
                    <Button Content="التالي" Command="{Binding NextCommand}" Margin="4" Padding="12,5"/>
                </StackPanel>
                <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>
            <Border Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="10" Background="{DynamicResource NativeSurface}"
                    BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1" CornerRadius="8" Padding="12"
                    Visibility="{Binding History.IsOpen, Converter={StaticResource VisibilityIfTrue}}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="إغلاق الأرشيف" Command="{Binding History.CloseCommand}" Padding="10,5"/>
                            <TextBlock Text="أرشيف القيود المعدلة والمخفية" FontWeight="Bold" FontSize="18" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{Binding History.ScopeLabel}" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Text="للقراءة فقط — يعرض جميع إصدارات التعديل والإخفاء، ولا يحذف الدليل الأصلي." TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}"/>
                        <TextBlock Text="{Binding History.Error}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"/>
                        <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding History.IsLoading, Converter={StaticResource VisibilityIfTrue}}"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="السابق" Command="{Binding History.PreviousCommand}" Margin="4" Padding="10,5"/>
                            <Button Content="التالي" Command="{Binding History.NextCommand}" Margin="4" Padding="10,5"/>
                            <Button Content="تحديث" Command="{Binding History.RefreshCommand}" Margin="4" Padding="10,5"/>
                        </StackPanel>
                        <TextBlock Text="{Binding History.PageLabel}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding History.Rows}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              HeadersVisibility="Column" SelectionMode="Single" Margin="0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="معرف القيد" Binding="{Binding AuditEventId}" Width="115"/>
                            <DataGridTextColumn Header="العملية الأصلية" Binding="{Binding OperationCode}" Width="110"/>
                            <DataGridTextColumn Header="الإصدار" Binding="{Binding After.Version}" Width="55"/>
                            <DataGridTextColumn Header="الإجراء" Binding="{Binding ActionLabel}" Width="85"/>
                            <DataGridTextColumn Header="المنفذ" Binding="{Binding EditedByDisplay}" Width="120"/>
                            <DataGridTextColumn Header="معرف المنفذ" Binding="{Binding EditedByUserId}" Width="100"/>
                            <DataGridTextColumn Header="التوقيت UTC" Binding="{Binding EditedAtUtc}" Width="150"/>
                            <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="160"/>
                            <DataGridTextColumn Header="الوصف الأصلي" Binding="{Binding RawDescription}" Width="180"/>
                            <DataGridTextColumn Header="الوصف السابق" Binding="{Binding Before.Description}" Width="180"/>
                            <DataGridTextColumn Header="الوصف اللاحق" Binding="{Binding After.Description}" Width="180"/>
                            <DataGridTextColumn Header="الحالة السابقة" Binding="{Binding BeforeVisibility}" Width="90"/>
                            <DataGridTextColumn Header="الحالة اللاحقة" Binding="{Binding AfterVisibility}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NativeAccountsPageViewModel}">
        <Grid FlowDirection="RightToLeft">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderStyle}"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource NativeMuted}" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,8">
                    <TextBlock Text="الأدوار المتاحة للإنشاء حسب صلاحيتك:" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding CreationRoleLabel}" Foreground="{DynamicResource NativeSuccessText}" TextWrapping="Wrap"/>
                </WrapPanel>
                <WrapPanel Margin="0,4" IsEnabled="{Binding CanQuery}">
                    <TextBlock Text="بحث بالاسم أو اسم المستخدم أو الرقم (ع)" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Text="{Binding Term, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                             Width="180" Margin="4" AutomationProperties.Name="بحث حسابات المستخدمين"/>
                    <Button Content="بحث" Command="{Binding SearchCommand}" Padding="10,5" Margin="4"/>
                    <Button Content="تحديث" Command="{Binding RefreshCommand}" Padding="10,5" Margin="4"/>
                </WrapPanel>
                <Button Content="إنشاء حساب جديد" Command="{Binding OpenCreateCommand}" Margin="0,4" Padding="12,6"
                        HorizontalAlignment="Right" Visibility="{Binding CanOpenCreate, Converter={StaticResource VisibilityIfTrue}}"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"/>
                <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityIfTrue}}"/>
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      HeadersVisibility="Column" Margin="0,8" SelectionMode="Single"
                      AutomationProperties.Name="كشف حسابات المستخدمين للقراءة فقط">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الرقم" Binding="{Binding Index}" Width="55"/>
                    <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="120"/>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="180"/>
                    <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="85"/>
                    <DataGridTextColumn Header="الصلاحية" Binding="{Binding RoleLabel}" Width="130"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding ActiveLabel}" Width="75"/>
                    <DataGridTextColumn Header="صلاحية الإدارة" Binding="{Binding ModifyLabel}" Width="110"/>
                    <DataGridTextColumn Header="أنشئ بواسطة" Binding="{Binding CreatedBy}" Width="150"/>
                    <DataGridTextColumn Header="تاريخ الإنشاء UTC" Binding="{Binding CreatedAtUtc}" Width="155"/>
                    <DataGridTemplateColumn Header="إدارة الحساب" Width="255">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <WrapPanel>
                                    <Button Content="كلمة المرور" Padding="5,3" Margin="2"
                                            Command="{Binding DataContext.ChangePasswordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}"/>
                                    <Button Content="تعطيل" Padding="5,3" Margin="2" Foreground="{DynamicResource NativeDangerText}"
                                            Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}"/>
                                    <Button Content="تفعيل" Padding="5,3" Margin="2" Foreground="{DynamicResource NativeSuccessText}"
                                            Command="{Binding DataContext.ReactivateCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}"/>
                                </WrapPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="2">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="السابق" Command="{Binding PreviousCommand}" Margin="4" Padding="10,5"/>
                    <Button Content="التالي" Command="{Binding NextCommand}" Margin="4" Padding="10,5"/>
                </StackPanel>
                <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </DockPanel>
            <Border Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="10" Background="{DynamicResource NativeSurface}"
                    BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1" CornerRadius="8" Padding="10"
                    Visibility="{Binding Create.IsOpen, Converter={StaticResource VisibilityIfTrue}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Top" Content="إغلاق مراجعة الإنشاء" Command="{Binding CloseCreateCommand}"
                            HorizontalAlignment="Left" Padding="12,5" Margin="0,0,0,6"/>
                    <views:NativeAccountCreateView DataContext="{Binding Create}"/>
                </DockPanel>
            </Border>
            <Border Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="11" Background="{DynamicResource NativeSurface}"
                    BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1" CornerRadius="8" Padding="10"
                    Visibility="{Binding Lifecycle.IsOpen, Converter={StaticResource VisibilityIfTrue}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Top" Content="إغلاق مراجعة الحساب" Command="{Binding CloseLifecycleCommand}"
                            HorizontalAlignment="Left" Padding="12,5" Margin="0,0,0,6"/>
                    <views:NativeAccountLifecycleView DataContext="{Binding Lifecycle}"/>
                </DockPanel>
            </Border>
        </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportsPageViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderStyle}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusStyle}" />
            <Border Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="16" Margin="6">
                <StackPanel>
                    <TextBlock Text="تقارير الأفراد والمجموعات" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource NativeHeading}"/>
                    <TextBlock Text="للإدارة العامة والإدارة: افتح سجل الأفراد، ثم اختر الفرد للتقرير التاريخي أو اختر التقرير الجماعي. تتاح معاينة Excel داخل التقرير وفق الصلاحيات المعتمدة."
                               TextWrapping="Wrap" Margin="0,8"/>
                    <Button Content="فتح تقارير الأفراد والمجموعات"
                            Command="{Binding OpenPersonnelReportsCommand}" Padding="12,8"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="16" Margin="6">
                <StackPanel>
                    <TextBlock Text="التمام الشهري وتصدير Excel" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource NativeHeading}"/>
