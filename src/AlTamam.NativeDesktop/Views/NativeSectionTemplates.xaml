                            HorizontalAlignment="Right"/>
                    <Button Content="تصدير الكشوفات العامة"
                            Command="{Binding DataContext.OpenRosterExportCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Padding="12,8" Margin="0,6,0,0" HorizontalAlignment="Right"
