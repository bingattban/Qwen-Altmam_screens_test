                        <TextBlock Text="{Binding Overview.Snapshot.DirectoryLabel}" TextWrapping="Wrap"/>
                        <TextBlock Text="موعد النسخ التلقائي المحفوظ" FontWeight="SemiBold" Margin="0,8,0,3"/>
                        <TextBlock Text="{Binding Overview.Snapshot.BackupTime}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Overview.Snapshot.BackupEnabledLabel}"/>
                        <TextBlock Text="{Binding Overview.Snapshot.RetentionLabel}"/>
                        <TextBlock Text="آخر نسخة تلقائية ناجحة مسجلة" FontWeight="SemiBold" Margin="0,8,0,3"/>
                        <TextBlock Text="{Binding Overview.Snapshot.LastBackupLabel}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Overview.Snapshot.LastBackupFailure}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"/>
                        <StackPanel Visibility="{Binding Overview.Snapshot.HasAttendanceSettings, Converter={StaticResource VisibilityIfTrue}}">
                            <TextBlock Text="التحضير التلقائي وقفل التمام — السياسة المحفوظة" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <TextBlock Text="وقت التحضير التلقائي" Margin="0,5,0,2"/>
                            <TextBlock Text="{Binding Overview.Snapshot.AttendanceSettings.DueTime}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            <TextBlock Text="وقت قفل التمام اليومي" Margin="0,5,0,2"/>
                            <TextBlock Text="{Binding Overview.Snapshot.AttendanceSettings.LockTime}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            <TextBlock Text="الحالة الافتراضية عند عدم وجود تحضير أمس" Margin="0,5,0,2"/>
                            <TextBlock Text="{Binding Overview.Snapshot.AttendanceSettings.DefaultLabel}" TextWrapping="Wrap"/>
                            <TextBlock Text="قراءة الإعدادات المحفوظة فقط. لن ينشئ هذا العرض سجلات تحضير، ولن يغير موعد القفل أو الحالة الافتراضية." TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}" Margin="0,5,0,8"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Overview.Snapshot.HasMonthlyExport, Converter={StaticResource VisibilityIfTrue}}">
                            <TextBlock Text="التصدير التلقائي للتمام الشهري — الإعدادات المحفوظة" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <TextBlock Text="{Binding Overview.Snapshot.MonthlyExport.EnabledLabel}"/>
                            <TextBlock Text="موعد التصدير المحفوظ" Margin="0,5,0,2"/>
                            <TextBlock Text="{Binding Overview.Snapshot.MonthlyExport.ExportTime}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            <TextBlock Text="مجلد التصدير المحفوظ" Margin="0,5,0,2"/>
                            <TextBlock Text="{Binding Overview.Snapshot.MonthlyExport.DirectoryLabel}" TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                            <TextBlock Text="آخر تصدير ناجح مسجل" Margin="0,5,0,2"/>
                            <TextBlock Text="{Binding Overview.Snapshot.MonthlyExport.LastSuccessLabel}"/>
                            <TextBlock Text="{Binding Overview.Snapshot.MonthlyExport.LastFailure}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"/>
                            <TextBlock Text="يعمل المجدول الأصلي أثناء تشغيل البرنامج. هذه الإعدادات المحفوظة لا تثبت نجاح تصدير جديد أو توفر المجلد حاليا؛ حدّث الإعدادات لعرض آخر نتيجة." TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}" Margin="0,5,0,8"/>
                        </StackPanel>
                        <TextBlock Text="المظهر المحفوظ" FontWeight="SemiBold" Margin="0,8,0,3"/>
                        <TextBlock Text="{Binding Overview.Snapshot.ThemeLabel}"/>
                        <WrapPanel Margin="0,5,0,0">
                            <Button Content="حفظ المظهر النهاري" Command="{Binding Overview.SaveLightCommand}" Padding="12,6" Margin="4"/>
                            <Button Content="حفظ المظهر الليلي" Command="{Binding Overview.SaveDarkCommand}" Padding="12,6" Margin="4"/>
                        </WrapPanel>
                        <ProgressBar Height="4" IsIndeterminate="True" Margin="0,4"
                                     Visibility="{Binding Overview.IsSavingTheme, Converter={StaticResource VisibilityIfTrue}}"/>
                        <TextBlock Text="يتم حفظ الاختيار في الإعداد الأصلي وتطبيق الألوان المشتركة على الواجهات. بعض عناصر Windows الأصلية تخضع لمظهر النظام." TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}"/>
                        <TextBlock Text="هذه قراءة للإعدادات المحفوظة وآخر النتائج المسجلة. يعمل المجدول الأصلي أثناء تشغيل البرنامج؛ تفعيل الإعداد وحده لا يعني نجاح النسخ. حدّث الإعدادات لعرض آخر نتيجة." TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}" Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                    CornerRadius="6" Padding="14" Margin="6">
                <StackPanel>
                    <TextBlock Text="بيانات البرنامج وفحص السلامة" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource NativeHeading}"/>
                    <TextBlock Text="معلومات الإصدار المثبت وفحص قاعدة البيانات المحلية للقراءة فقط، دون إرسال أي بيانات خارج الجهاز."
                               TextWrapping="Wrap" Margin="0,6"/>
                    <WrapPanel>
                        <Button Content="عرض بيانات البرنامج" Command="{Binding Diagnostics.RefreshCommand}" Padding="12,6" Margin="4"/>
                        <Button Content="فحص سلامة قاعدة البيانات" Command="{Binding Diagnostics.CheckCommand}" Padding="12,6" Margin="4"/>
                    </WrapPanel>
                    <ProgressBar Height="4" IsIndeterminate="True" Margin="0,6"
                                 Visibility="{Binding Diagnostics.IsBusy, Converter={StaticResource VisibilityIfTrue}}"/>
                    <TextBlock Text="{Binding Diagnostics.Error}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"/>
                    <StackPanel Visibility="{Binding Diagnostics.HasInformation, Converter={StaticResource VisibilityIfTrue}}">
                        <TextBlock Text="إصدار الواجهة الأصلية التجريبية" FontWeight="SemiBold" Margin="0,6,0,2"/>
                        <TextBlock Text="{Binding Diagnostics.Information.Version}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                        <TextBlock Text="معمارية العملية" FontWeight="SemiBold" Margin="0,6,0,2"/>
                        <TextBlock Text="{Binding Diagnostics.Information.Architecture}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                        <TextBlock Text="إصدار .NET المستخدم" FontWeight="SemiBold" Margin="0,6,0,2"/>
                        <TextBlock Text="{Binding Diagnostics.Information.Runtime}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                        <TextBlock Text="إصدار المخطط المدعوم" FontWeight="SemiBold" Margin="0,6,0,2"/>
                        <TextBlock Text="{Binding Diagnostics.Information.SchemaVersion}"/>
                        <TextBlock Text="{Binding Diagnostics.Information.OfflineLabel}" TextWrapping="Wrap" Margin="0,6"/>
                        <TextBlock Text="{Binding Diagnostics.IntegrityLabel}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6"/>
                        <TextBlock Text="تخص النتيجة وقت الفحص فقط؛ لا تعد بديلا عن نسخة احتياطية مشفرة ومتحقق منها."
                                   TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <views:NativeMonthlyExportScheduleView/>
            <views:NativeManualBackupView/>
            <Button Content="إعداد النسخ الاحتياطي التلقائي" Command="{Binding OpenScheduleCommand}"
                    Padding="12,8" Margin="6"/>
            <Border Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1" CornerRadius="6"
                    Padding="14" Margin="6" Visibility="{Binding Schedule.IsOpen, Converter={StaticResource VisibilityIfTrue}}">
                <StackPanel>
                    <TextBlock Text="مراجعة إعداد النسخ التلقائي" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource NativeHeading}"/>
                    <TextBlock Text="{Binding Schedule.Before.BackupDirectory}" TextWrapping="Wrap" FlowDirection="LeftToRight" Margin="0,5"/>
                    <TextBlock Text="{Binding Schedule.Before.DirectoryLabel}" TextWrapping="Wrap"/>
                    <StackPanel IsEnabled="{Binding Schedule.CanEdit}">
                        <CheckBox Content="تفعيل النسخ الاحتياطي التلقائي" IsChecked="{Binding Schedule.Enabled, Mode=TwoWay}" Margin="0,8"/>
                        <TextBlock Text="وقت النسخ (HH:mm) بنظام 24 ساعة"/>
                        <TextBox Text="{Binding Schedule.Time, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                                 FlowDirection="LeftToRight" Margin="0,4,0,8"/>
                        <TextBlock Text="عدد النسخ التلقائية المحتفظ بها (0 للجميع، أو 2 إلى 365)" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding Schedule.RetentionText, UpdateSourceTrigger=PropertyChanged}" MaxLength="3"
                                 FlowDirection="LeftToRight" Margin="0,4,0,8"/>
                        <TextBlock Text="تنبيه: تحديد عدد غير صفري يسمح بحذف النسخ التلقائية القديمة المؤهلة بعد نجاح نسخة تلقائية موثوقة، وفقا لسياسة الاحتفاظ الأصلية. لا يشمل ذلك النسخ اليدوية أو الإنقاذية." Foreground="{DynamicResource NativeWarningText}" TextWrapping="Wrap"/>
                        <Button Content="معاينة الإعداد" Command="{Binding Schedule.PreviewCommand}" Padding="10,6" Margin="0,8"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding Schedule.HasPreview, Converter={StaticResource VisibilityIfTrue}}">
                        <TextBlock Text="الإعداد قبل وبعد التغيير" FontWeight="Bold" Margin="0,6"/>
                        <TextBlock Text="{Binding Schedule.Before.BackupEnabledLabel}"/>
                        <TextBlock Text="{Binding Schedule.Before.BackupTime}"/>
                        <TextBlock Text="{Binding Schedule.Before.RetentionLabel}"/>
                        <TextBlock Text="{Binding Schedule.Prepared.EnabledLabel}" FontWeight="Bold" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding Schedule.Prepared.Time}"/>
                        <TextBlock Text="{Binding Schedule.Prepared.RetentionLabel}" TextWrapping="Wrap"/>
                        <Button Content="{Binding Schedule.ConfirmLabel}" Command="{Binding Schedule.ConfirmCommand}" Padding="10,6" Margin="0,8"/>
                    </StackPanel>
                    <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding Schedule.IsBusy, Converter={StaticResource VisibilityIfTrue}}"/>
                    <TextBlock Text="{Binding Schedule.Error}" TextWrapping="Wrap" Foreground="{DynamicResource NativeDangerText}"/>
                    <TextBlock Text="{Binding Schedule.CompletionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource NativeAccentText}"/>
                    <TextBlock Text="يقرأ المجدول الأصلي الإعدادات أثناء تشغيل البرنامج ويتحقق من الموعد كل دقيقة. حفظ الإعداد لا يعني إنشاء نسخة ناجحة." TextWrapping="Wrap" Margin="0,6"/>
                    <Button Content="إغلاق مراجعة الجدولة" Command="{Binding CloseScheduleCommand}" Padding="10,6"/>
                </StackPanel>
            </Border>
            <Button Content="استدراك يوم سابق (خلال 7 أيام)"
                    Command="{Binding OpenCatchUpCommand}" Padding="12,8" Margin="6"/>
            <Border Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                    CornerRadius="6" Padding="14" Margin="6"
                    Visibility="{Binding CatchUp.IsOpen, Converter={StaticResource VisibilityIfTrue}}">
                <StackPanel>
                    <TextBlock Text="استدراك التحضير الناقص — للإدارة فقط" FontWeight="Bold" Foreground="{DynamicResource NativeHeading}"/>
                    <TextBlock Text="يشمل هذا الإجراء الأفراد المؤهلين في جميع المواقع للتاريخ المحدد، وليس فردا واحدا أو موقعا واحدا. لا يستبدل التمام المحفوظ." TextWrapping="Wrap" Margin="0,6"/>
                    <TextBlock Text="تاريخ الاستدراك (yyyy-MM-dd)" Margin="0,6,0,2"/>
                    <TextBox Text="{Binding CatchUp.DateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
