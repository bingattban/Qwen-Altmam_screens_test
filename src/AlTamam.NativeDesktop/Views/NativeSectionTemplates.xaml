                                      SelectedValuePath="StatusId" SelectedValue="{Binding HistoricalRange.SelectedStatusId, Mode=TwoWay}"
                                      IsEnabled="{Binding HistoricalRange.CanEdit}" AutomationProperties.Name="حالة التصحيح التاريخي"/>
                            <TextBlock Text="سبب التعديل (10 إلى 400 حرف)" Margin="0,6,0,2"/>
                            <TextBox Text="{Binding HistoricalRange.Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="400" TextWrapping="Wrap" MinHeight="45" IsEnabled="{Binding HistoricalRange.CanEdit}"
                                     AutomationProperties.Name="سبب التصحيح التاريخي"/>
                            <Button Content="معاينة الأيام قبل التعديل" Command="{Binding HistoricalRange.PreviewCommand}" Padding="10,6" Margin="0,8"/>
                            <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding HistoricalRange.IsBusy, Converter={StaticResource VisibilityIfTrue}}"/>
                            <TextBlock Text="{Binding HistoricalRange.Error}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding HistoricalRange.Preview.PersonName}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding HistoricalRange.Preview.ServiceNumberA}"/>
                            <TextBlock Text="{Binding HistoricalRange.PreviewSummary}" FontWeight="Bold" TextWrapping="Wrap"/>
                            <DataGrid ItemsSource="{Binding HistoricalRange.Preview.Days}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False" Height="220" AutomationProperties.Name="معاينة أيام التصحيح">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding BusinessDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                                    <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="*"/>
                                    <DataGridTextColumn Header="قبل" Binding="{Binding BeforeStatusName}" Width="*"/>
                                    <DataGridTextColumn Header="بعد" Binding="{Binding AfterStatusName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding HistoricalRange.Preview.Request.Reason}" TextWrapping="Wrap"/>
                            <Button Content="{Binding HistoricalRange.ConfirmLabel}" Command="{Binding HistoricalRange.ConfirmCommand}" Padding="10,6" Margin="0,8"/>
                            <TextBlock Text="{Binding HistoricalRange.CompletionMessage}" Foreground="{DynamicResource NativeAccentText}" TextWrapping="Wrap"/>
                            <Button Content="إغلاق مراجعة التصحيح" Command="{Binding CloseHistoricalRangeCommand}" Padding="10,6"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1" CornerRadius="6" Padding="10"
                            Visibility="{Binding HistoricalSingle.IsOpen, Converter={StaticResource VisibilityIfTrue}}">
                        <StackPanel>
                            <TextBlock Text="تصحيح يوم مغلق محفوظ" FontWeight="Bold" Foreground="{DynamicResource NativeHeading}"/>
                            <TextBlock Text="التصحيح الاستثنائي ليوم سابق واحد؛ لا يعاد فتح اليوم ولا يتغير وقت التحضير الأصلي. الخدمة تتحقق من الإذن والأهلية." TextWrapping="Wrap" Margin="0,6"/>
                            <TextBlock Text="{Binding Historical.Evidence.Request.From, StringFormat=yyyy-MM-dd}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            <TextBlock Text="الحالة المصححة" Margin="0,6,0,2"/>
                            <ComboBox ItemsSource="{Binding HistoricalSingle.StatusChoices}" DisplayMemberPath="DisplayName"
                                      SelectedValuePath="StatusId" SelectedValue="{Binding HistoricalSingle.SelectedStatusId, Mode=TwoWay}"
                                      IsEnabled="{Binding HistoricalSingle.CanEdit}" AutomationProperties.Name="حالة تصحيح اليوم المغلق"/>
                            <TextBlock Text="السبب (10 إلى 400 حرف)" Margin="0,6,0,2"/>
                            <TextBox Text="{Binding HistoricalSingle.Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="400" TextWrapping="Wrap" MinHeight="45" IsEnabled="{Binding HistoricalSingle.CanEdit}"
                                     AutomationProperties.Name="سبب تصحيح اليوم المغلق"/>
                            <Button Content="معاينة التصحيح الاستثنائي" Command="{Binding HistoricalSingle.PreviewCommand}" Padding="10,6" Margin="0,8"/>
                            <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding HistoricalSingle.IsBusy, Converter={StaticResource VisibilityIfTrue}}"/>
                            <TextBlock Text="{Binding HistoricalSingle.Error}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding HistoricalSingle.Preview.PersonName}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding HistoricalSingle.Preview.ServiceNumberA}"/>
                            <TextBlock Text="{Binding HistoricalSingle.Preview.SiteName}"/>
                            <TextBlock Text="الحالة السابقة" FontWeight="Bold"/>
                            <TextBlock Text="{Binding HistoricalSingle.Preview.BeforeStatusName}"/>
                            <TextBlock Text="الحالة الجديدة" FontWeight="Bold"/>
                            <TextBlock Text="{Binding HistoricalSingle.Preview.AfterStatusName}" Foreground="{DynamicResource NativeAccentText}"/>
                            <TextBlock Text="{Binding HistoricalSingle.Preview.Request.Reason}" TextWrapping="Wrap"/>
                            <Button Content="{Binding HistoricalSingle.ConfirmLabel}" Command="{Binding HistoricalSingle.ConfirmCommand}" Padding="10,6" Margin="0,8"/>
                            <TextBlock Text="{Binding HistoricalSingle.CompletionMessage}" Foreground="{DynamicResource NativeAccentText}" TextWrapping="Wrap"/>
                            <Button Content="إغلاق مراجعة اليوم المغلق" Command="{Binding CloseHistoricalSingleCommand}" Padding="10,6"/>
                        </StackPanel>
                    </Border>
                    <Button Content="إغلاق البحث التاريخي" Command="{Binding Historical.CloseCommand}" Padding="10,6" Margin="0,8"/>
                </StackPanel>
            </Border>
            <UniformGrid Columns="2" IsEnabled="False">
                <Button Content="النسخ الاحتياطي" Height="55" Margin="6" />
                <Button Content="استعادة نسخة احتياطية" Height="55" Margin="6" />
                <Button Content="المظهر" Height="55" Margin="6" />
                <Button Content="حول البرنامج" Height="55" Margin="6" />
            </UniformGrid>
        </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
