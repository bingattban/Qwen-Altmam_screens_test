                </StackPanel>
            </Border>
            <TextBlock Text="الخيارات غير المتاحة تظهر معطلة؛ لا يمنح هذا القسم صلاحيات جديدة."
                       Foreground="{DynamicResource NativeMuted}" TextWrapping="Wrap" Margin="6"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
