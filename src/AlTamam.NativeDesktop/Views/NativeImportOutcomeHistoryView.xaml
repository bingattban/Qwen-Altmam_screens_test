<UserControl x:Class="AlTamam.NativeDesktop.Views.NativeImportOutcomeHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="OutcomeVisible"/>
        <Style x:Key="OutcomeButton" TargetType="Button">
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#C80F172A"
          Visibility="{Binding IsOpen, Converter={StaticResource OutcomeVisible}}">
        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="9" Padding="14" Margin="16" MaxWidth="1080"
                HorizontalAlignment="Center" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,9">
                    <Button Content="إغلاق" DockPanel.Dock="Left"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource OutcomeButton}"/>
                    <TextBlock Text="سجل دفعات استيراد Excel — قراءة فقط"
                               FontSize="20" FontWeight="Bold" Foreground="#0F2942"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button Content="تحديث أحدث 30 دفعة"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource OutcomeButton}"/>
                    <Button Content="عرض تفاصيل الدفعة المحددة"
                            Command="{Binding DetailsCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=ImportBatchesGrid}"
                            Style="{StaticResource OutcomeButton}"
                            AutomationProperties.Name="عرض الصفوف المرفوضة لدفعة Excel المختارة"/>
                    <TextBlock Text="تظهر الدفعات التي أنشأها الحساب الحالي فقط."
                               VerticalAlignment="Center" Margin="12,0"
                               Foreground="#475569" TextWrapping="Wrap"/>
                </WrapPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding LoadError}" Foreground="#BE123C"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding DetailError}" Foreground="#BE123C"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar Height="4" IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource OutcomeVisible}}"/>
                    <ProgressBar Height="4" IsIndeterminate="True"
                                 Visibility="{Binding IsDetailLoading, Converter={StaticResource OutcomeVisible}}"/>
                </StackPanel>
                <DataGrid x:Name="ImportBatchesGrid" Grid.Row="3"
                          ItemsSource="{Binding Batches}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" Margin="0,4,0,8"
                          AlternatingRowBackground="#F8FAFC"
                          AutomationProperties.Name="دفعات الاستيراد الأصلية المحفوظة">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding ImportBatchId}" Width="2*"/>
                        <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="2*"/>
                        <DataGridTextColumn Header="صفوف" Binding="{Binding TotalRows}" Width="65"/>
                        <DataGridTextColumn Header="مقبولة" Binding="{Binding AcceptedRows}" Width="70"/>
                        <DataGridTextColumn Header="مرفوضة" Binding="{Binding RejectedRows}" Width="70"/>
                        <DataGridTextColumn Header="تاريخ الحفظ UTC" Binding="{Binding CommittedAtUtc}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="4" Visibility="{Binding HasDetails, Converter={StaticResource OutcomeVisible}}"
                        BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                        Background="#F8FAFC" Padding="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                            <Button Content="إغلاق التفاصيل" DockPanel.Dock="Left"
                                    Command="{Binding CloseDetailsCommand}"
                                    Style="{StaticResource OutcomeButton}"/>
                            <TextBlock Text="الصفوف المرفوضة المحفوظة مع سبب الرفض"
                                       Foreground="#0F2942" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding SelectedDetail.Batch.ImportBatchId}"
                                   Foreground="#475569" Margin="2,0,2,5"/>
                        <DataGrid ItemsSource="{Binding SelectedDetail.Issues}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" AlternatingRowBackground="#FFFBEB"
                                  AutomationProperties.Name="أسباب رفض صفوف Excel المحفوظة">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الصف" Binding="{Binding Row}" Width="55"/>
                                <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="*"/>
                                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="*"/>
                                <DataGridTextColumn Header="سبب الرفض" Binding="{Binding Reason}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
