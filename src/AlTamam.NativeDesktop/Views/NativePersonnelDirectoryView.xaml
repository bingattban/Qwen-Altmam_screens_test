<UserControl x:Class="AlTamam.NativeDesktop.Views.NativePersonnelDirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AlTamam.NativeDesktop.Views"
             FlowDirection="RightToLeft" FontFamily="Segoe UI"
             Background="{DynamicResource NativeSurface}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="PersonnelVisible"/>
        <Style x:Key="PersonnelButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource NativeAccentFill}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource NativeSubtle}" BorderBrush="{DynamicResource NativeSubtleBorder}"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="الإدارة — سجل الأفراد" Foreground="{DynamicResource NativeText}"
                           FontSize="22" FontWeight="Bold"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeSubtleBorder}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <WrapPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="الموقع" FontWeight="SemiBold" Foreground="{DynamicResource NativeText}"/>
                    <ComboBox Width="160" Height="34" Margin="0,4,0,0"
                              ItemsSource="{Binding SiteOptions}"
                              DisplayMemberPath="Name" SelectedValuePath="SiteId"
                              SelectedValue="{Binding SelectedSiteId, Mode=OneWay}"
                              SelectionChanged="OnSiteChanged"
                              AutomationProperties.Name="تصفية سجل الأفراد حسب الموقع"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="حالة الفرد" FontWeight="SemiBold" Foreground="{DynamicResource NativeText}"/>
                    <ComboBox Width="175" Height="34" Margin="0,4,0,0"
                              ItemsSource="{Binding StatusOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedStatus, Mode=OneWay}"
                              SelectionChanged="OnStatusChanged"
                              AutomationProperties.Name="اختيار حالة الأفراد"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="الاسم أو الرقم (ع)" FontWeight="SemiBold"
                               Foreground="{DynamicResource NativeText}"/>
                    <TextBox Width="200" Height="34" Margin="0,4,0,0" Padding="8,4"
                             Text="{Binding SearchDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="بحث سجل الأفراد"/>
                </StackPanel>
                <Button Content="بحث" Style="{StaticResource PersonnelButton}"
                        VerticalAlignment="Bottom" Command="{Binding SearchCommand}"/>
                <Button Content="مسح" Style="{StaticResource PersonnelButton}"
                        VerticalAlignment="Bottom" Command="{Binding ClearSearchCommand}"/>
                <Button Content="تحديث" Style="{StaticResource PersonnelButton}"
                        VerticalAlignment="Bottom" Command="{Binding RefreshCommand}"/>
                <Button Content="التقرير الجماعي — تحديد أفراد من الصفحة"
                        Style="{StaticResource PersonnelButton}" VerticalAlignment="Bottom"
                        Command="{Binding OpenGroupReportCommand}"
                        AutomationProperties.Name="فتح التقرير الجماعي التاريخي للقراءة فقط واختيار فرد إلى 100 فرد من الصفحة"/>
                <Button Content="التقرير التاريخي للفرد المحدد"
                        Style="{StaticResource PersonnelButton}" VerticalAlignment="Bottom"
                        Command="{Binding OpenPersonnelReportCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=PersonnelGrid}"
                        AutomationProperties.Name="فتح التقرير التاريخي للهوية الثابتة للفرد المحدد"/>
                <Button Content="عرض ملف الفرد المحدد"
                        Style="{StaticResource PersonnelButton}" VerticalAlignment="Bottom"
                        Command="{Binding OpenProfileCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=PersonnelGrid}"
                        AutomationProperties.Name="فتح تفاصيل فرد بالمعرف الثابت"/>
                <Button Content="استيراد كشف أفراد Excel"
                        Style="{StaticResource PersonnelButton}" VerticalAlignment="Bottom"
                        Command="{Binding OpenExcelImportCommand}"
                        AutomationProperties.Name="اختيار ملف Excel ومعاينة الأفراد الجدد والمواقع قبل الحفظ"/>
                <Button Content="سجل دفعات استيراد Excel"
                        Style="{StaticResource PersonnelButton}" VerticalAlignment="Bottom"
                        Command="{Binding OpenImportHistoryCommand}"
                        AutomationProperties.Name="عرض دفعات Excel المحفوظة والأسماء المرفوضة دون تعديل"/>
                <Button Content="تعديل تمام سابق" Style="{StaticResource PersonnelButton}"
                        VerticalAlignment="Bottom"
                        Command="{Binding DataContext.OpenAdministrativeHistoricalCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        AutomationProperties.Name="فتح البحث التاريخي وتصحيح التمام السابق من الإدارة"/>
                <Button Content="هيكل الكشوفات والأعمدة" Style="{StaticResource PersonnelButton}"
                        VerticalAlignment="Bottom" Command="{Binding OpenColumnLayoutCommand}"
                        AutomationProperties.Name="عرض تعريفات أعمدة الكشوفات الأصلية"/>
                <Button Content="إدارة حالات التحضير" Style="{StaticResource PersonnelButton}"
                        VerticalAlignment="Bottom"
                        Command="{Binding OpenStatusCatalogCommand}"
                        AutomationProperties.Name="فتح إضافة وتعديل وتعطيل حالات التحضير الأصلية"/>
                <Button Content="إدارة المواقع" Style="{StaticResource PersonnelButton}"
                        VerticalAlignment="Bottom"
                        Command="{Binding OpenSiteCatalogCommand}"
                        AutomationProperties.Name="إدارة المواقع المعتمدة إضافة وتعديل"/>
                <Button Content="إضافة فرد" Style="{StaticResource PersonnelButton}"
                        VerticalAlignment="Bottom" Command="{Binding OpenCreateCommand}"
                        AutomationProperties.Name="بدء مراجعة إضافة فرد جديد"/>
                <Button Content="تعديل اسم أو رقم الفرد المحدد"
                        Style="{StaticResource PersonnelButton}" VerticalAlignment="Bottom"
                        Command="{Binding OpenEditCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=PersonnelGrid}"
                        AutomationProperties.Name="بدء مراجعة تعديل هوية الفرد المحدد"/>
                <Button Content="نقل جماعي خارجي — الصفحة الحالية"
                        Style="{StaticResource PersonnelButton}" VerticalAlignment="Bottom"
                        Command="{Binding OpenBulkExternalTransferCommand}"
                        AutomationProperties.Name="نقل خارجي جماعي لأفراد محددين مع الإقرار بتعليق حساباتهم"/>
                <Button Content="نقل جماعي داخلي — الصفحة الحالية"
                        Style="{StaticResource PersonnelButton}" VerticalAlignment="Bottom"
                        Command="{Binding OpenBulkInternalTransferCommand}"
                        AutomationProperties.Name="فتح النقل الجماعي الداخلي للأفراد المختارين فقط من الصفحة الحالية"/>
                <Button Content="نقل داخلي"
                        Style="{StaticResource PersonnelButton}" VerticalAlignment="Bottom"
                        Command="{Binding OpenInternalTransferCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=PersonnelGrid}"
                        AutomationProperties.Name="نقل الفرد المحدد داخليا بعد اختيار الموقع المصدر"/>
                <Button Content="إعادة الفرد المؤرشف للخدمة"
                        Style="{StaticResource PersonnelButton}" VerticalAlignment="Bottom"
                        Command="{Binding OpenArchivedReturnCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=PersonnelGrid}"
                        AutomationProperties.Name="طلب إعادة نفس الفرد المؤرشف مع معاينة الهوية والتأكيد"/>
                <Button Content="فصل الفرد المحدد"
                        Style="{StaticResource PersonnelButton}" VerticalAlignment="Bottom"
                        Command="{Binding OpenSeparationCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=PersonnelGrid}"
                        AutomationProperties.Name="فصل الفرد المحدد بعد مراجعة السبب والتأكيد"/>
                <Button Content="أرشيف الفصل" Style="{StaticResource PersonnelButton}"
                        VerticalAlignment="Bottom"
                        Command="{Binding OpenSeparationArchiveCommand}"
                        AutomationProperties.Name="عرض سجلات الفصل التاريخية للقراءة فقط"/>
                <Button Content="أرشيف التنقلات" Style="{StaticResource PersonnelButton}"
                        VerticalAlignment="Bottom"
                        Command="{Binding OpenMovementArchiveCommand}"
                        AutomationProperties.Name="فتح أرشيف التنقلات للقراءة فقط"/>
                <Button Content="نقل خارجي"
                        Style="{StaticResource PersonnelButton}" VerticalAlignment="Bottom"
                        Command="{Binding OpenExternalTransferCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=PersonnelGrid}"
                        AutomationProperties.Name="نقل الفرد المحدد خارجيا بعد اختيار الموقع المصدر"/>
            </WrapPanel>
        </Border>
        <StackPanel Grid.Row="2" Margin="4,2,4,8">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}"/>
            <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap"
                       Foreground="{DynamicResource NativeDangerText}" FontWeight="SemiBold"
                       AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar Height="4" IsIndeterminate="True" Foreground="{DynamicResource NativeAccentText}"
                         Visibility="{Binding IsLoading, Converter={StaticResource PersonnelVisible}}"/>
        </StackPanel>
        <DataGrid x:Name="PersonnelGrid" Grid.Row="3" ItemsSource="{Binding Rows}"
                  IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" SelectionMode="Single"
                  SelectionUnit="FullRow" HeadersVisibility="Column"
                  RowHeight="35" ColumnHeaderHeight="38" MinHeight="190"
                  GridLinesVisibility="Horizontal" AlternatingRowBackground="{DynamicResource NativeSubtle}"
                  BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الرقم" Binding="{Binding RowNumber}" Width="62"/>
                <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="95"/>
                <DataGridTextColumn Header="الرتبة" Binding="{Binding Rank}" Width="95"/>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="*"/>
                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding PageLabel}" DockPanel.Dock="Right"
                       Foreground="{DynamicResource NativeMuted}" VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="السابق" Style="{StaticResource PersonnelButton}"
                        Command="{Binding PreviousPageCommand}"/>
                <Button Content="التالي" Style="{StaticResource PersonnelButton}"
                        Command="{Binding NextPageCommand}"/>
            </StackPanel>
        </DockPanel>
        <!-- Read-only identity history; no editing, deleting, restoring or
             transferring is permitted by this first native admin slice. -->
        <Border Grid.RowSpan="5" Background="#B80F172A" Panel.ZIndex="110"
                Visibility="{Binding IsProfileOpen, Converter={StaticResource PersonnelVisible}}">
            <Border Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="18"
                    Width="580" MaxHeight="540"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="ملف الفرد — قراءة فقط" Foreground="{DynamicResource NativeText}"
                                   FontWeight="Bold" FontSize="19" DockPanel.Dock="Right"/>
                        <Button Content="إغلاق" Style="{StaticResource PersonnelButton}"
                                Command="{Binding CloseProfileCommand}"
                                AutomationProperties.Name="إغلاق ملف الفرد"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ProgressBar Height="5" IsIndeterminate="True"
                                         Visibility="{Binding IsProfileLoading, Converter={StaticResource PersonnelVisible}}"/>
                            <TextBlock Text="{Binding ProfileError}" Foreground="{DynamicResource NativeDangerText}"
                                       TextWrapping="Wrap" FontWeight="SemiBold"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="الاسم الحالي" Foreground="{DynamicResource NativeSecondary}"
                                       FontWeight="Bold" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedProfile.Name}"
                                       Foreground="{DynamicResource NativeText}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="الرقم (ع)" Foreground="{DynamicResource NativeSecondary}"
                                       FontWeight="Bold" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedProfile.ServiceNumberA}"
                                       Foreground="{DynamicResource NativeText}"/>
                            <TextBlock Text="أول تاريخ مسجل" Foreground="{DynamicResource NativeSecondary}"
                                       FontWeight="Bold" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedProfile.FirstRecordedLocalDate}"
                                       Foreground="{DynamicResource NativeText}" FlowDirection="LeftToRight"
                                       HorizontalAlignment="Right"/>
                            <Separator Margin="0,12,0,8"/>
                            <TextBlock Text="سجل الأسماء والأرقام المحفوظ" Foreground="{DynamicResource NativeText}"
                                       FontWeight="Bold" Margin="0,6,0,6"/>
                            <ItemsControl ItemsSource="{Binding SelectedProfile.IdentityHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource NativeSubtle}" BorderBrush="{DynamicResource NativeSubtleBorder}"
                                                BorderThickness="1" CornerRadius="5"
                                                Margin="0,3" Padding="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ServiceNumberA}"/>
                                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ValidFrom}"/>
                                                    <TextBlock Text=" — "/>
                                                    <TextBlock Text="{Binding ValidTo}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource NativeSecondary}"
                                       TextWrapping="Wrap"
                                       Text="إضافة الأفراد وتعديل هوياتهم والتنقلات الفردية تتم عبر المعاينة والتأكيد. الفصل وأرشيف الفصل متاحان عبر الواجهة الأصلية المعتمدة؛ عودة الأفراد المؤرشفين تستلزم اختيار نفس الهوية التاريخية؛ النقل الجماعي الداخلي متاح لأفراد الصفحة الحالية المحددين صراحة بعد المعاينة؛ النقل الجماعي الخارجي يتطلب إقرارا منفصلا بتعليق الحسابات المرتبطة وإلغاء جلساتها."/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
        <views:NativePersonnelMutationView Grid.RowSpan="5"
                                           DataContext="{Binding Mutation}"
                                           Panel.ZIndex="130"/>
        <views:NativePersonnelTransferView Grid.RowSpan="5"
                                           DataContext="{Binding Movement}"
                                           Panel.ZIndex="140"/>
        <views:NativeBulkInternalTransferView Grid.RowSpan="5"
                                              DataContext="{Binding BulkMovement}"
                                              Panel.ZIndex="145"/>
        <views:NativeBulkExternalTransferView Grid.RowSpan="5"
                                              DataContext="{Binding BulkExternalMovement}"
                                              Panel.ZIndex="147"/>
        <views:NativeMovementArchiveView Grid.RowSpan="5"
                                         DataContext="{Binding Archive}"
                                         Panel.ZIndex="150"/>
        <views:NativePersonnelSeparationView Grid.RowSpan="5"
                                             DataContext="{Binding Separation}"
                                             Panel.ZIndex="160"/>
        <views:NativeSeparationArchiveView Grid.RowSpan="5"
                                           DataContext="{Binding SeparationArchive}"
                                           Panel.ZIndex="170"/>
        <views:NativeArchivedReturnView Grid.RowSpan="5"
                                        DataContext="{Binding Return}"
                                        Panel.ZIndex="180"/>
        <views:NativeSiteCatalogView Grid.RowSpan="5"
                                     DataContext="{Binding SiteCatalog}"
                                     Panel.ZIndex="190"/>
        <views:NativeStatusCatalogView Grid.RowSpan="5"
                                       DataContext="{Binding StatusCatalog}"
                                       Panel.ZIndex="200"/>
        <views:NativeExcelPersonnelImportView Grid.RowSpan="5"
                                              DataContext="{Binding ExcelImport}"
                                              Panel.ZIndex="220"/>
        <views:NativeImportOutcomeHistoryView Grid.RowSpan="5"
                                              DataContext="{Binding ImportHistory}"
                                              Panel.ZIndex="225"/>
        <views:NativePersonnelReportView Grid.RowSpan="5"
                                         DataContext="{Binding ReportHistory}"
                                         Panel.ZIndex="230"/>
        <views:NativePersonnelGroupReportView Grid.RowSpan="5"
                                              DataContext="{Binding GroupReport}"
                                              Panel.ZIndex="235"/>
        <Grid Grid.RowSpan="5" Panel.ZIndex="240" Background="#B80F172A"
              DataContext="{Binding ColumnLayout}"
              Visibility="{Binding IsOpen, Converter={StaticResource PersonnelVisible}}"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeBorder}"
                    BorderThickness="1" CornerRadius="8" Margin="18" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="إغلاق" Command="{Binding CloseCommand}" Padding="14,6"/>
                        <TextBlock Text="هيكل الكشوفات — تعريفات الأعمدة" FontWeight="Bold" FontSize="20"
                                   Foreground="{DynamicResource NativeHeading}"/>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,10">
                        <TextBlock Text="عرض التعريفات النشطة والمعطلة والقيم المحفوظة. الأعمدة الأساسية محمية؛ التعديل والإضافة قيد الاستكمال." TextWrapping="Wrap"/>
                        <ProgressBar Height="4" Margin="0,6" IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource PersonnelVisible}}"/>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              AlternatingRowBackground="{DynamicResource NativeSubtle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الترتيب" Binding="{Binding DisplayOrder}" Width="75"/>
                            <DataGridTextColumn Header="عنوان العمود" Binding="{Binding Caption}" Width="2*"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding TypeLabel}" Width="*"/>
                            <DataGridTextColumn Header="الحماية" Binding="{Binding ProtectionLabel}" Width="*"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StateLabel}" Width="*"/>
                            <DataGridTextColumn Header="القيم المحفوظة" Binding="{Binding StoredValueCount}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="3" Content="تحديث التعريفات" Command="{Binding RefreshCommand}"
                            HorizontalAlignment="Right" Padding="14,7" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
