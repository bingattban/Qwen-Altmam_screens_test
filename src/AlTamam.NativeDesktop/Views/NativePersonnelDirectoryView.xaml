<UserControl x:Class="AlTamam.NativeDesktop.Views.NativePersonnelDirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI"
             Background="#FFFFFF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="PersonnelVisible"/>
        <Style x:Key="PersonnelButton" TargetType="Button">
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="الإدارة — سجل الأفراد" Foreground="#0F2942"
                           FontSize="22" FontWeight="Bold"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <WrapPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="الموقع" FontWeight="SemiBold" Foreground="#0F2942"/>
                    <ComboBox Width="160" Height="34" Margin="0,4,0,0"
                              ItemsSource="{Binding SiteOptions}"
                              DisplayMemberPath="Name" SelectedValuePath="SiteId"
                              SelectedValue="{Binding SelectedSiteId, Mode=OneWay}"
                              SelectionChanged="OnSiteChanged"
                              AutomationProperties.Name="تصفية سجل الأفراد حسب الموقع"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="حالة الفرد" FontWeight="SemiBold" Foreground="#0F2942"/>
                    <ComboBox Width="175" Height="34" Margin="0,4,0,0"
                              ItemsSource="{Binding StatusOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedStatus, Mode=OneWay}"
                              SelectionChanged="OnStatusChanged"
                              AutomationProperties.Name="اختيار حالة الأفراد"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="الاسم أو الرقم (ع)" FontWeight="SemiBold"
                               Foreground="#0F2942"/>
                    <TextBox Width="200" Height="34" Margin="0,4,0,0" Padding="8,4"
                             Text="{Binding SearchDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="بحث سجل الأفراد"/>
                </StackPanel>
                <Button Content="بحث" Style="{StaticResource PersonnelButton}"
                        VerticalAlignment="Bottom" Command="{Binding SearchCommand}"/>
                <Button Content="مسح" Style="{StaticResource PersonnelButton}"
                        VerticalAlignment="Bottom" Command="{Binding ClearSearchCommand}"/>
                <Button Content="تحديث" Style="{StaticResource PersonnelButton}"
                        VerticalAlignment="Bottom" Command="{Binding RefreshCommand}"/>
                <Button Content="عرض ملف الفرد المحدد"
                        Style="{StaticResource PersonnelButton}" VerticalAlignment="Bottom"
                        Command="{Binding OpenProfileCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=PersonnelGrid}"
                        AutomationProperties.Name="فتح تفاصيل فرد بالمعرف الثابت"/>
            </WrapPanel>
        </Border>
        <StackPanel Grid.Row="2" Margin="4,2,4,8">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#475569"/>
            <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap"
                       Foreground="#BE123C" FontWeight="SemiBold"
                       AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar Height="4" IsIndeterminate="True" Foreground="#0D9488"
                         Visibility="{Binding IsLoading, Converter={StaticResource PersonnelVisible}}"/>
        </StackPanel>
        <DataGrid x:Name="PersonnelGrid" Grid.Row="3" ItemsSource="{Binding Rows}"
                  IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" SelectionMode="Single"
                  SelectionUnit="FullRow" HeadersVisibility="Column"
                  RowHeight="35" ColumnHeaderHeight="38" MinHeight="190"
                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFC"
                  BorderBrush="#CBD5E1" BorderThickness="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الرقم" Binding="{Binding RowNumber}" Width="62"/>
                <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="95"/>
                <DataGridTextColumn Header="الرتبة" Binding="{Binding Rank}" Width="95"/>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="*"/>
                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding PageLabel}" DockPanel.Dock="Right"
                       Foreground="#475569" VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="السابق" Style="{StaticResource PersonnelButton}"
                        Command="{Binding PreviousPageCommand}"/>
                <Button Content="التالي" Style="{StaticResource PersonnelButton}"
                        Command="{Binding NextPageCommand}"/>
            </StackPanel>
        </DockPanel>
        <!-- Read-only identity history; no editing, deleting, restoring or
             transferring is permitted by this first native admin slice. -->
        <Border Grid.RowSpan="5" Background="#B80F172A" Panel.ZIndex="110"
                Visibility="{Binding IsProfileOpen, Converter={StaticResource PersonnelVisible}}">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1"
                    BorderThickness="1" CornerRadius="10" Padding="18"
                    Width="580" MaxHeight="540"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="ملف الفرد — قراءة فقط" Foreground="#0F2942"
                                   FontWeight="Bold" FontSize="19" DockPanel.Dock="Right"/>
                        <Button Content="إغلاق" Style="{StaticResource PersonnelButton}"
                                Command="{Binding CloseProfileCommand}"
                                AutomationProperties.Name="إغلاق ملف الفرد"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ProgressBar Height="5" IsIndeterminate="True"
                                         Visibility="{Binding IsProfileLoading, Converter={StaticResource PersonnelVisible}}"/>
                            <TextBlock Text="{Binding ProfileError}" Foreground="#BE123C"
                                       TextWrapping="Wrap" FontWeight="SemiBold"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="الاسم الحالي" Foreground="#64748B"
                                       FontWeight="Bold" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedProfile.Name}"
                                       Foreground="#0F2942" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="الرقم (ع)" Foreground="#64748B"
                                       FontWeight="Bold" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedProfile.ServiceNumberA}"
                                       Foreground="#0F2942"/>
                            <TextBlock Text="أول تاريخ مسجل" Foreground="#64748B"
                                       FontWeight="Bold" Margin="0,8,0,2"/>
                            <TextBlock Text="{Binding SelectedProfile.FirstRecordedLocalDate}"
                                       Foreground="#0F2942" FlowDirection="LeftToRight"
                                       HorizontalAlignment="Right"/>
                            <Separator Margin="0,12,0,8"/>
                            <TextBlock Text="سجل الأسماء والأرقام المحفوظ" Foreground="#0F2942"
                                       FontWeight="Bold" Margin="0,6,0,6"/>
                            <ItemsControl ItemsSource="{Binding SelectedProfile.IdentityHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                BorderThickness="1" CornerRadius="5"
                                                Margin="0,3" Padding="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ServiceNumberA}"/>
                                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ValidFrom}"/>
                                                    <TextBlock Text=" — "/>
                                                    <TextBlock Text="{Binding ValidTo}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,12,0,0" Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Text="الإضافة وتعديل الأسماء والتنقلات والفصل والاستعادة ستُنقل لاحقا عبر خدماتها الأصلية بعد اختبارات الصلاحيات والتأكيد."/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
