<UserControl x:Class="AlTamam.NativeDesktop.Views.NativeLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI"
             Background="#F1F5F9">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="AuthCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="AuthField" TargetType="TextBox">
            <Setter Property="Height" Value="43"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AuthPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="43"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="540" Margin="20,24">
            <Border Width="540" MaxWidth="540" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="#FFFFFF"
                    CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.13" Color="#0F2942"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Same navy/teal identity, card hierarchy and Arabic labels
                         as src/AlTamam.WebUI/assets/css/altamam.css .auth-brand. -->
                    <Border Background="#0F2942" CornerRadius="12,12,0,0" Padding="23,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#0D9488" CornerRadius="10" Width="44" Height="44">
                                <TextBlock Text="ت" Foreground="#FFFFFF" FontSize="25"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="التمام اليومي" Foreground="#FFFFFF"
                                           FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="نظام إدارة القوة والتحضير — تسجيل محلي آمن"
                                           Foreground="#D8E8F1" FontSize="13" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="25,22,25,24">
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#0F2942"
                                   Text="تسجيل الدخول إلى التمام اليومي" Margin="0,0,0,18"/>
                        <TextBlock Text="اسم المستخدم" Style="{StaticResource AuthCaption}"/>
                        <TextBox x:Name="UsernameInput" Style="{StaticResource AuthField}"
                                 FlowDirection="LeftToRight" TextAlignment="Left"
                                 AutomationProperties.Name="اسم المستخدم" Margin="0,0,0,15"/>
                        <TextBlock Text="كلمة المرور" Style="{StaticResource AuthCaption}"/>
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource AuthPassword}"
                                     FlowDirection="LeftToRight"
                                     AutomationProperties.Name="كلمة المرور" Margin="0,0,0,14"/>

                        <StackPanel Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1"
                                    CornerRadius="8" Padding="13" Margin="0,1,0,15">
                                <TextBlock Text="التهيئة الأولى: اختر اسم الإدارة العامة وكلمة مرور تتضمن 3 أحرف إنجليزية و3 أرقام على الأقل، ثم أكدها. لا توجد بيانات دخول افتراضية."
                                           TextWrapping="Wrap" FontSize="13" Foreground="#0F2942"/>
                            </Border>
                            <TextBlock Text="الاسم الكامل (اختياري)" Style="{StaticResource AuthCaption}"/>
                            <TextBox x:Name="FullNameInput" Style="{StaticResource AuthField}"
                                     MaxLength="200" Margin="0,0,0,14"/>
                            <TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource AuthCaption}"/>
                            <PasswordBox x:Name="ConfirmPasswordInput"
                                         Style="{StaticResource AuthPassword}" FlowDirection="LeftToRight"
                                         AutomationProperties.Name="تأكيد كلمة المرور" Margin="0,0,0,16"/>
                        </StackPanel>

                        <TextBlock Text="يعمل البرنامج على هذا الجهاز دون اتصال بالإنترنت."
                                   Foreground="#475569" TextWrapping="Wrap"
                                   FontSize="13" Margin="0,0,0,11"/>
                        <TextBlock Text="{Binding LoginError}" Foreground="#BE123C"
                                   TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                                   AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
                        <Button x:Name="SubmitButton" Height="45" Cursor="Hand"
                                Click="OnSubmitClick" IsDefault="True"
                                IsEnabled="{Binding IsReady}"
                                BorderThickness="0" Foreground="#FFFFFF"
                                FontWeight="Bold" FontSize="16"
                                Background="#0D9488" Content="دخول">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="دخول"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFirstRun}" Value="True">
                                            <Setter Property="Content" Value="إنشاء الإدارة العامة والدخول"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
