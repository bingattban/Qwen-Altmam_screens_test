<UserControl x:Class="AlTamam.NativeDesktop.Views.NativePersonnelReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style x:Key="ReportAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource NativeAccentFill}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="ReportSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NativeText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,13,0,6"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#C80F172A"
          Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhenTrue}}">
        <Border Background="{DynamicResource NativeSurface}" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                CornerRadius="9" Padding="14" Margin="12" MaxWidth="1140"
                HorizontalAlignment="Center" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button Content="إغلاق" DockPanel.Dock="Left"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource ReportAction}"/>
                    <TextBlock Text="التقرير التاريخي الموحد — تقرير فرد (قراءة فقط)"
                               FontSize="20" Foreground="{DynamicResource NativeText}"
                               FontWeight="Bold" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </DockPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="يعرض سجلات الفرد الفعلية عبر المعرف الثابت؛ التاريخ والفترة المعروضة لا يغيران السجلات. يمكن معاينة التقرير المعتمد وتصديره إلى Excel دون تعديل السجلات."
                               TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}"/>
                    <TextBlock Text="تصفية الفترة الزمنية (شاملة يوم البداية والنهاية). اترك الحقل فارغا لعرض السجل دون حد."
                               TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}" Margin="0,8,0,3"/>
                    <WrapPanel Orientation="Horizontal" Margin="0,2,0,4"
                               AutomationProperties.Name="حدود الفترة التاريخية الفردية">
                        <TextBlock Text="من تاريخ" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox Width="122" MaxLength="10" Height="32" Padding="7,4"
                                 VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                                 Text="{Binding DateFromDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="تاريخ بداية التقرير بصيغة YYYY-MM-DD"/>
                        <TextBlock Text="إلى تاريخ" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <TextBox Width="122" MaxLength="10" Height="32" Padding="7,4"
                                 VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                                 Text="{Binding DateToDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="تاريخ نهاية التقرير بصيغة YYYY-MM-DD"/>
                        <Button Content="تطبيق الفترة" Command="{Binding ApplyDateFiltersCommand}"
                                Style="{StaticResource ReportAction}"/>
                        <Button Content="مسح الفترة" Command="{Binding ClearDateFiltersCommand}"
                                Style="{StaticResource ReportAction}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding AppliedDateRangeLabel}" FontWeight="SemiBold"
                               Foreground="{DynamicResource NativeText}" Margin="0,0,0,5"
                               AutomationProperties.Name="الفترة المطبقة على النتائج التاريخية"/>
                    <TextBlock Text="تنبيه: تصفية الفترة تشمل التحضير والتنقلات والتصحيحات وسجل العمليات؛ يبقى تاريخ تغيير هوية الفرد وانتسابه للمواقع كاملا للمراجعة."
                               TextWrapping="Wrap" Foreground="{DynamicResource NativeSecondary}" Margin="0,0,0,5"/>
                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,3"
                               AutomationProperties.Name="مرشح نوع الحركة التاريخية للفرد">
                        <TextBlock Text="نوع الحركة" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <ComboBox Width="195" MinHeight="34"
                                  ItemsSource="{Binding MovementTypeOptions}"
                                  DisplayMemberPath="Title" SelectedValuePath="Value"
                                  SelectedValue="{Binding MovementTypeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="اختر نوع الحركة لتصفية سجل التنقلات فقط"/>
                        <Button Content="تطبيق النوع" Command="{Binding ApplyMovementTypeFilterCommand}"
                                Style="{StaticResource ReportAction}"/>
                        <Button Content="جميع الحركات" Command="{Binding ClearMovementTypeFilterCommand}"
                                Style="{StaticResource ReportAction}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding AppliedMovementTypeLabel}" FontWeight="SemiBold"
                               Foreground="{DynamicResource NativeText}" Margin="0,0,0,3"
                               AutomationProperties.Name="نوع الحركة المطبق حاليا"/>
                    <TextBlock Text="مرشح نوع الحركة يغير سجل الحركات فقط؛ لا يغير التحضير أو الإجماليات الشهرية أو سجل الهوية والمواقع."
                               TextWrapping="Wrap" Foreground="{DynamicResource NativeSecondary}" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource NativeDangerText}"
                               FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar Height="4" IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhenTrue}}"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,8">
                        <Button Content="معاينة تصدير التقرير إلى Excel"
                                Command="{Binding Excel.OpenPreviewCommand}"
                                Style="{StaticResource ReportAction}" HorizontalAlignment="Right"
                                AutomationProperties.Name="معاينة تصدير التقرير الفردي إلى Excel"/>
                        <Border Background="{DynamicResource NativeCanvas}" BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,4,0,8"
                                DataContext="{Binding Excel}"
                                Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhenTrue}}">
                            <StackPanel>
                                <TextBlock Text="معاينة تصدير التقرير الفردي" FontSize="17"
                                           FontWeight="Bold" Foreground="{DynamicResource NativeText}"/>
                                <TextBlock Text="يشمل الملف تسع أوراق من السجلات الكاملة، وليس الصفحة الظاهرة فقط. راجع النطاق والمجلد ثم أكد الحفظ. الموافقة صالحة لدقيقتين."
                                           TextWrapping="Wrap" Margin="0,6"/>
                                <TextBlock Text="{Binding Preview.Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Preview.ServiceNumberA}" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding PreviewScope}" Margin="0,6"
                                           TextWrapping="Wrap" Foreground="{DynamicResource NativeText}"
                                           AutomationProperties.Name="نطاق تصدير التقرير المعتمد"/>
                                <TextBlock Text="الفترة تخص التحضير والحركات والتصحيحات والعمليات؛ يبقى تاريخ الهوية والمواقع كاملا. نوع الحركة يخص الحركات فقط."
                                           TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}" Margin="0,0,0,4"/>
                                <WrapPanel Margin="0,4">
                                    <TextBlock Text="التحضير: "/><TextBlock Text="{Binding Preview.AttendanceTotal}" Margin="0,0,12,0"/>
                                    <TextBlock Text="الهوية: "/><TextBlock Text="{Binding Preview.IdentityTotal}" Margin="0,0,12,0"/>
                                    <TextBlock Text="الحركات: "/><TextBlock Text="{Binding Preview.MovementTotal}" Margin="0,0,12,0"/>
                                    <TextBlock Text="التصحيحات: "/><TextBlock Text="{Binding Preview.RevisionTotal}" Margin="0,0,12,0"/>
                                    <TextBlock Text="العمليات: "/><TextBlock Text="{Binding Preview.AuditTotal}" Margin="0,0,12,0"/>
                                    <TextBlock Text="المواقع: "/><TextBlock Text="{Binding Preview.SiteTotal}"/>
                                </WrapPanel>
                                <TextBlock Text="مجلد الحفظ المعتمد:" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBox Text="{Binding Preview.Directory, Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                                <ProgressBar Height="4" IsIndeterminate="True" Margin="0,6"
                                             Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}"/>
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NativeDangerText}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock Text="{Binding CompletionMessage}" Foreground="{DynamicResource NativeSuccessText}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <TextBox Text="{Binding Receipt.FilePath, Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="Wrap" FlowDirection="LeftToRight" Margin="0,4"/>
                                <WrapPanel>
                                    <Button Content="تأكيد وحفظ Excel" Command="{Binding ConfirmCommand}"
                                            Style="{StaticResource ReportAction}"/>
                                    <Button Content="إغلاق المعاينة" Command="{Binding CloseCommand}"
                                            Style="{StaticResource ReportAction}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource NativeCanvas}" Padding="10" CornerRadius="6"
                                BorderBrush="{DynamicResource NativeSubtleBorder}" BorderThickness="1">
                            <WrapPanel>
                                <TextBlock Text="الاسم الحالي: " FontWeight="SemiBold" Foreground="{DynamicResource NativeText}"/>
                                <TextBlock Text="{Binding Report.Name}" Margin="2,0,16,0"/>
                                <TextBlock Text="الرقم (ع): " FontWeight="SemiBold" Foreground="{DynamicResource NativeText}"/>
                                <TextBlock Text="{Binding Report.ServiceNumberA}" Margin="2,0,16,0"/>
                                <TextBlock Text="أول تسجيل: " FontWeight="SemiBold" Foreground="{DynamicResource NativeText}"/>
                                <TextBlock Text="{Binding Report.FirstRecordedDate}"/>
                            </WrapPanel>
                        </Border>
                        <TextBlock Text="مرشحات الموقع والحالة التاريخيين (المعرفات ثابتة حتى عند تغيير الأسماء). تطبق على السجلات الأصلية ولا تنشئ سجلات جديدة."
                                   TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}" Margin="0,10,0,3"/>
                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,4"
                                   AutomationProperties.Name="مرشحات الموقع والحالة التاريخية">
                            <TextBlock Text="الموقع" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <ComboBox Width="190" MinHeight="34"
                                      ItemsSource="{Binding SiteFilterOptions}"
                                      DisplayMemberPath="Title" SelectedValuePath="Id"
                                      SelectedValue="{Binding SiteIdDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="الموقع التاريخي للبحث بمعرف ثابت"/>
                            <TextBlock Text="الحالة" VerticalAlignment="Center" Margin="12,0,4,0"/>
                            <ComboBox Width="175" MinHeight="34"
                                      ItemsSource="{Binding StatusFilterOptions}"
                                      DisplayMemberPath="Title" SelectedValuePath="Id"
                                      SelectedValue="{Binding StatusIdDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="حالة التحضير التاريخية بمعرف ثابت"/>
                            <Button Content="تطبيق الموقع والحالة"
                                    Command="{Binding ApplySiteStatusFiltersCommand}"
                                    Style="{StaticResource ReportAction}"/>
                            <Button Content="مسح الموقع والحالة"
                                    Command="{Binding ClearSiteStatusFiltersCommand}"
                                    Style="{StaticResource ReportAction}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding AppliedSiteStatusLabel}"
                                   Foreground="{DynamicResource NativeText}" FontWeight="SemiBold" Margin="0,0,0,4"
                                   AutomationProperties.Name="الموقع والحالة المطبقان على السجلات"/>
                        <TextBlock Text="الموقع يقيّد التحضير والحركات والتصحيحات؛ الحالة تقيّد التحضير والتصحيحات فقط. أما سجل الهوية والانتساب للمواقع وسجل التدقيق فيظل كاملا وفق الخدمة الأصلية."
                                   TextWrapping="Wrap" Foreground="{DynamicResource NativeSecondary}" Margin="0,0,0,5"/>
                        <TextBlock Text="إجماليات حالات التحضير التاريخية" Style="{StaticResource ReportSection}"/>
                        <DataGrid ItemsSource="{Binding Report.StatusTotals}" AutoGenerateColumns="False"
                                  Height="130" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserDeleteRows="False" AlternatingRowBackground="{DynamicResource NativeSubtle}"
                                  AutomationProperties.Name="ملخص حالات التحضير المحفوظة تاريخيا">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الحالة التاريخية" Binding="{Binding StatusName}" Width="2*"/>
                                <DataGridTextColumn Header="عدد الأيام" Binding="{Binding Count}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,10,0,2">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding PreviousAttendanceCommand}"
                                        Style="{StaticResource ReportAction}"/>
                                <Button Content="التالي" Command="{Binding NextAttendanceCommand}"
                                        Style="{StaticResource ReportAction}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AttendancePageLabel}"
                                       Style="{StaticResource ReportSection}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="الاسم والرقم التاريخيان غير الموثقين لا يستبدلان بالقيم الحالية."
                                   TextWrapping="Wrap" Foreground="{DynamicResource NativeSecondary}"/>
                        <DataGrid ItemsSource="{Binding Report.Attendance}" Height="200"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="{DynamicResource NativeSubtle}"
                                  AutomationProperties.Name="سجل التحضير التاريخي للصفحة المختارة">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="*"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusName}" Width="*"/>
                                <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="*"/>
                                <DataGridTextColumn Header="الاسم وقتها" Binding="{Binding HistoricalNameDisplay}" Width="2*"/>
                                <DataGridTextColumn Header="الرقم (ع) وقتها" Binding="{Binding HistoricalNumberDisplay}" Width="*"/>
                                <DataGridTextColumn Header="المصدر" Binding="{Binding Source}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,10,0,2">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding PreviousMovementsCommand}"
                                        Style="{StaticResource ReportAction}"/>
                                <Button Content="التالي" Command="{Binding NextMovementsCommand}"
                                        Style="{StaticResource ReportAction}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MovementsPageLabel}"
                                       Style="{StaticResource ReportSection}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Report.Movements}" Height="190"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="{DynamicResource NativeSubtle}"
                                  AutomationProperties.Name="التنقلات والفصل والعودة المسجلة للصفحة المختارة">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="*"/>
                                <DataGridTextColumn Header="العملية" Binding="{Binding Type}" Width="*"/>
                                <DataGridTextColumn Header="من" Binding="{Binding Source}" Width="*"/>
                                <DataGridTextColumn Header="إلى" Binding="{Binding Destination}" Width="*"/>
                                <DataGridTextColumn Header="الاسم وقتها" Binding="{Binding NameSnapshot}" Width="2*"/>
                                <DataGridTextColumn Header="المنفذ" Binding="{Binding Executor}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,10,0,2">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding PreviousIdentitiesCommand}"
                                        Style="{StaticResource ReportAction}"/>
                                <Button Content="التالي" Command="{Binding NextIdentitiesCommand}"
                                        Style="{StaticResource ReportAction}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding IdentitiesPageLabel}"
                                       Style="{StaticResource ReportSection}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Report.Identities}" Height="180"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="{DynamicResource NativeSubtle}"
                                  AutomationProperties.Name="سجل هوية الفرد المحفوظة بالمعرف الثابت">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="*"/>
                                <DataGridTextColumn Header="من" Binding="{Binding ValidFrom}" Width="*"/>
                                <DataGridTextColumn Header="إلى" Binding="{Binding ValidTo}" Width="*"/>
                                <DataGridTextColumn Header="سبب التغيير" Binding="{Binding Reason}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,10,0,2">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding PreviousSitesCommand}"
                                        Style="{StaticResource ReportAction}"/>
                                <Button Content="التالي" Command="{Binding NextSitesCommand}"
                                        Style="{StaticResource ReportAction}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SitesPageLabel}"
                                       Style="{StaticResource ReportSection}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="المواقع حسب فترات انتساب الفرد الفعلية، بما فيها المواقع المسماة تاريخيا."
                                   Foreground="{DynamicResource NativeSecondary}" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Report.Sites}" Height="190"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="{DynamicResource NativeSubtle}"
                                  AutomationProperties.Name="مواقع الفرد التاريخية حسب فترات الانتساب">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الموقع وقتها" Binding="{Binding SiteName}" Width="2*"/>
                                <DataGridTextColumn Header="من" Binding="{Binding ValidFrom}" Width="*"/>
                                <DataGridTextColumn Header="إلى" Binding="{Binding ValidTo}" Width="*"/>
                                <DataGridTextColumn Header="وقت تسجيل الانتساب" Binding="{Binding CreatedAtUtc}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,10,0,2">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding PreviousRevisionsCommand}"
                                        Style="{StaticResource ReportAction}"/>
                                <Button Content="التالي" Command="{Binding NextRevisionsCommand}"
                                        Style="{StaticResource ReportAction}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RevisionsPageLabel}"
                                       Style="{StaticResource ReportSection}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="التصحيحات المعتمدة محفوظة بأثر مستقل عن حالة التحضير الحالية ولا يمكن تعديلها من التقرير."
                                   Foreground="{DynamicResource NativeSecondary}" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Report.Revisions}" Height="200"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="{DynamicResource NativeSubtle}"
                                  AutomationProperties.Name="سجل تصحيحات حالات التحضير المؤرشف">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="تاريخ التحضير" Binding="{Binding Date}" Width="*"/>
                                <DataGridTextColumn Header="قبل" Binding="{Binding Before}" Width="*"/>
                                <DataGridTextColumn Header="بعد" Binding="{Binding After}" Width="*"/>
                                <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="2*"/>
                                <DataGridTextColumn Header="المنفذ تاريخيا" Binding="{Binding ExecutorSnapshot}" Width="2*"/>
                                <DataGridTextColumn Header="وقت التصحيح" Binding="{Binding ExecutedAtUtc}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="ملخص الحضور الشهري حسب الحالة التاريخية"
                                   Style="{StaticResource ReportSection}"/>
                        <TextBlock Text="إجماليات كاملة من السجلات المعتمدة، وليست إعادة احتساب للأيام الظاهرة في الصفحة."
                                   Foreground="{DynamicResource NativeSecondary}" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Report.MonthlyTotals}" Height="190"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="{DynamicResource NativeSubtle}"
                                  AutomationProperties.Name="الإجماليات الشهرية للحالات التاريخية">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الشهر" Binding="{Binding Period}" Width="*"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusName}" Width="2*"/>
                                <DataGridTextColumn Header="الأيام" Binding="{Binding Count}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,10,0,2">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding PreviousAuditCommand}"
                                        Style="{StaticResource ReportAction}"/>
                                <Button Content="التالي" Command="{Binding NextAuditCommand}"
                                        Style="{StaticResource ReportAction}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AuditPageLabel}"
                                       Style="{StaticResource ReportSection}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="سجل العمليات التاريخي للقراءة فقط؛ أسماء المستخدمين والمنفذين محفوظة كما سُجلت وقت العملية."
                                   Foreground="{DynamicResource NativeSecondary}" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Report.Audit}" Height="200"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="{DynamicResource NativeSubtle}"
                                  AutomationProperties.Name="سجل عمليات الفرد المحفوظ حسب تاريخ تنفيذ العملية">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="العملية" Binding="{Binding Operation}" Width="*"/>
                                <DataGridTextColumn Header="تاريخها" Binding="{Binding EffectiveDate}" Width="*"/>
                                <DataGridTextColumn Header="وقت التنفيذ" Binding="{Binding ExecutedAtUtc}" Width="2*"/>
                                <DataGridTextColumn Header="اسم المستخدم وقتها" Binding="{Binding UsernameSnapshot}" Width="*"/>
                                <DataGridTextColumn Header="المنفذ وقتها" Binding="{Binding FullNameSnapshot}" Width="2*"/>
                                <DataGridTextColumn Header="الوصف المحفوظ" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
