<UserControl x:Class="AlTamam.NativeDesktop.Views.NativePersonnelReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style x:Key="ReportAction" TargetType="Button">
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="ReportSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F2942"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,13,0,6"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#C80F172A"
          Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhenTrue}}">
        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="9" Padding="14" Margin="12" MaxWidth="1140"
                HorizontalAlignment="Center" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button Content="إغلاق" DockPanel.Dock="Left"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource ReportAction}"/>
                    <TextBlock Text="التقرير التاريخي الموحد — تقرير فرد (قراءة فقط)"
                               FontSize="20" Foreground="#0F2942"
                               FontWeight="Bold" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </DockPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="يعرض هذا الجزء البيانات التاريخية الفعلية للفرد المحدد بمعرفه الثابت؛ التقارير الجماعية والتصدير واستكمال سجل التدقيق في مراحل لاحقة."
                               TextWrapping="Wrap" Foreground="#475569"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#BE123C"
                               FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar Height="4" IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhenTrue}}"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,8">
                        <Border Background="#F1F5F9" Padding="10" CornerRadius="6"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <WrapPanel>
                                <TextBlock Text="الاسم الحالي: " FontWeight="SemiBold" Foreground="#0F2942"/>
                                <TextBlock Text="{Binding Report.Name}" Margin="2,0,16,0"/>
                                <TextBlock Text="الرقم (ع): " FontWeight="SemiBold" Foreground="#0F2942"/>
                                <TextBlock Text="{Binding Report.ServiceNumberA}" Margin="2,0,16,0"/>
                                <TextBlock Text="أول تسجيل: " FontWeight="SemiBold" Foreground="#0F2942"/>
                                <TextBlock Text="{Binding Report.FirstRecordedDate}"/>
                            </WrapPanel>
                        </Border>
                        <TextBlock Text="إجماليات حالات التحضير التاريخية" Style="{StaticResource ReportSection}"/>
                        <DataGrid ItemsSource="{Binding Report.StatusTotals}" AutoGenerateColumns="False"
                                  Height="130" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserDeleteRows="False" AlternatingRowBackground="#F8FAFC"
                                  AutomationProperties.Name="ملخص حالات التحضير المحفوظة تاريخيا">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الحالة التاريخية" Binding="{Binding StatusName}" Width="2*"/>
                                <DataGridTextColumn Header="عدد الأيام" Binding="{Binding Count}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,10,0,2">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding PreviousAttendanceCommand}"
                                        Style="{StaticResource ReportAction}"/>
                                <Button Content="التالي" Command="{Binding NextAttendanceCommand}"
                                        Style="{StaticResource ReportAction}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AttendancePageLabel}"
                                       Style="{StaticResource ReportSection}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="الاسم والرقم التاريخيان غير الموثقين لا يستبدلان بالقيم الحالية."
                                   TextWrapping="Wrap" Foreground="#64748B"/>
                        <DataGrid ItemsSource="{Binding Report.Attendance}" Height="200"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="#F8FAFC"
                                  AutomationProperties.Name="سجل التحضير التاريخي للصفحة المختارة">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="*"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusName}" Width="*"/>
                                <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="*"/>
                                <DataGridTextColumn Header="الاسم وقتها" Binding="{Binding HistoricalNameDisplay}" Width="2*"/>
                                <DataGridTextColumn Header="الرقم (ع) وقتها" Binding="{Binding HistoricalNumberDisplay}" Width="*"/>
                                <DataGridTextColumn Header="المصدر" Binding="{Binding Source}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,10,0,2">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding PreviousMovementsCommand}"
                                        Style="{StaticResource ReportAction}"/>
                                <Button Content="التالي" Command="{Binding NextMovementsCommand}"
                                        Style="{StaticResource ReportAction}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MovementsPageLabel}"
                                       Style="{StaticResource ReportSection}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Report.Movements}" Height="190"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="#F8FAFC"
                                  AutomationProperties.Name="التنقلات والفصل والعودة المسجلة للصفحة المختارة">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="*"/>
                                <DataGridTextColumn Header="العملية" Binding="{Binding Type}" Width="*"/>
                                <DataGridTextColumn Header="من" Binding="{Binding Source}" Width="*"/>
                                <DataGridTextColumn Header="إلى" Binding="{Binding Destination}" Width="*"/>
                                <DataGridTextColumn Header="الاسم وقتها" Binding="{Binding NameSnapshot}" Width="2*"/>
                                <DataGridTextColumn Header="المنفذ" Binding="{Binding Executor}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,10,0,2">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding PreviousIdentitiesCommand}"
                                        Style="{StaticResource ReportAction}"/>
                                <Button Content="التالي" Command="{Binding NextIdentitiesCommand}"
                                        Style="{StaticResource ReportAction}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding IdentitiesPageLabel}"
                                       Style="{StaticResource ReportSection}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Report.Identities}" Height="180"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="#F8FAFC"
                                  AutomationProperties.Name="سجل هوية الفرد المحفوظة بالمعرف الثابت">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="*"/>
                                <DataGridTextColumn Header="من" Binding="{Binding ValidFrom}" Width="*"/>
                                <DataGridTextColumn Header="إلى" Binding="{Binding ValidTo}" Width="*"/>
                                <DataGridTextColumn Header="سبب التغيير" Binding="{Binding Reason}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,10,0,2">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding PreviousSitesCommand}"
                                        Style="{StaticResource ReportAction}"/>
                                <Button Content="التالي" Command="{Binding NextSitesCommand}"
                                        Style="{StaticResource ReportAction}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SitesPageLabel}"
                                       Style="{StaticResource ReportSection}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="المواقع حسب فترات انتساب الفرد الفعلية، بما فيها المواقع المسماة تاريخيا."
                                   Foreground="#64748B" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Report.Sites}" Height="190"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="#F8FAFC"
                                  AutomationProperties.Name="مواقع الفرد التاريخية حسب فترات الانتساب">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الموقع وقتها" Binding="{Binding SiteName}" Width="2*"/>
                                <DataGridTextColumn Header="من" Binding="{Binding ValidFrom}" Width="*"/>
                                <DataGridTextColumn Header="إلى" Binding="{Binding ValidTo}" Width="*"/>
                                <DataGridTextColumn Header="وقت تسجيل الانتساب" Binding="{Binding CreatedAtUtc}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,10,0,2">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding PreviousRevisionsCommand}"
                                        Style="{StaticResource ReportAction}"/>
                                <Button Content="التالي" Command="{Binding NextRevisionsCommand}"
                                        Style="{StaticResource ReportAction}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RevisionsPageLabel}"
                                       Style="{StaticResource ReportSection}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="التصحيحات المعتمدة محفوظة بأثر مستقل عن حالة التحضير الحالية ولا يمكن تعديلها من التقرير."
                                   Foreground="#64748B" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Report.Revisions}" Height="200"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="#F8FAFC"
                                  AutomationProperties.Name="سجل تصحيحات حالات التحضير المؤرشف">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="تاريخ التحضير" Binding="{Binding Date}" Width="*"/>
                                <DataGridTextColumn Header="قبل" Binding="{Binding Before}" Width="*"/>
                                <DataGridTextColumn Header="بعد" Binding="{Binding After}" Width="*"/>
                                <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="2*"/>
                                <DataGridTextColumn Header="المنفذ تاريخيا" Binding="{Binding ExecutorSnapshot}" Width="2*"/>
                                <DataGridTextColumn Header="وقت التصحيح" Binding="{Binding ExecutedAtUtc}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="ملخص الحضور الشهري حسب الحالة التاريخية"
                                   Style="{StaticResource ReportSection}"/>
                        <TextBlock Text="إجماليات كاملة من السجلات المعتمدة، وليست إعادة احتساب للأيام الظاهرة في الصفحة."
                                   Foreground="#64748B" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Report.MonthlyTotals}" Height="190"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="#F8FAFC"
                                  AutomationProperties.Name="الإجماليات الشهرية للحالات التاريخية">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الشهر" Binding="{Binding Period}" Width="*"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusName}" Width="2*"/>
                                <DataGridTextColumn Header="الأيام" Binding="{Binding Count}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,10,0,2">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding PreviousAuditCommand}"
                                        Style="{StaticResource ReportAction}"/>
                                <Button Content="التالي" Command="{Binding NextAuditCommand}"
                                        Style="{StaticResource ReportAction}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AuditPageLabel}"
                                       Style="{StaticResource ReportSection}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="سجل العمليات التاريخي للقراءة فقط؛ أسماء المستخدمين والمنفذين محفوظة كما سُجلت وقت العملية."
                                   Foreground="#64748B" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding Report.Audit}" Height="200"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  AlternatingRowBackground="#F8FAFC"
                                  AutomationProperties.Name="سجل عمليات الفرد المحفوظ حسب تاريخ تنفيذ العملية">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="العملية" Binding="{Binding Operation}" Width="*"/>
                                <DataGridTextColumn Header="تاريخها" Binding="{Binding EffectiveDate}" Width="*"/>
                                <DataGridTextColumn Header="وقت التنفيذ" Binding="{Binding ExecutedAtUtc}" Width="2*"/>
                                <DataGridTextColumn Header="اسم المستخدم وقتها" Binding="{Binding UsernameSnapshot}" Width="*"/>
                                <DataGridTextColumn Header="المنفذ وقتها" Binding="{Binding FullNameSnapshot}" Width="2*"/>
                                <DataGridTextColumn Header="الوصف المحفوظ" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
