<UserControl x:Class="AlTamam.NativeDesktop.Views.NativePersonnelExcelImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ImportVisible"/>
        <Style x:Key="ImportButton" TargetType="Button">
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#D40F172A"
          Visibility="{Binding IsOpen, Converter={StaticResource ImportVisible}}">
        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="10" Padding="15" Width="930" MaxHeight="765"
                Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                    <Button Content="إغلاق دون استيراد" DockPanel.Dock="Left"
                            Style="{StaticResource ImportButton}"
                            Command="{Binding CloseCommand}"/>
                    <TextBlock Text="استيراد كشف الأفراد — Excel XLSX"
                               FontSize="19" Foreground="#0F2942" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="إضافة آمنة للأفراد الجدد فقط. لا يحل ملف Excel محل هوية أو اسم أو موقع أو تحضير شخص موجود. يتعرف النظام على تكرار الرقم (ع) وعلى الهوية المؤرشفة ويحفظ الأسباب في سجل الاستيراد."
                                   Foreground="#475569" TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1"
                                BorderThickness="1" CornerRadius="6"
                                Padding="10" Margin="0,0,0,9">
                            <StackPanel>
                                <TextBlock Text="الخطوة الأولى — اختيار ملف XLSX من جهاز Windows"
                                           FontWeight="Bold" Foreground="#0F2942"/>
                                <TextBlock Text="الحد الأقصى: 160 كيلوبايت و500 صف. تُستورد الورقة الأولى افتراضيا؛ يمكن اختيار كل أوراق الملف قبل تحديده. لن تُحفَظ بيانات عند اختيار الملف."
                                           TextWrapping="Wrap" Foreground="#475569"
                                           Margin="0,4,0,8"/>
                                <CheckBox IsChecked="{Binding ImportAllSheets, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanEdit}" Margin="0,2,0,8"
                                          AutomationProperties.Name="اختيار كل أوراق Excel مع مسح المعاينة القديمة">
                                    <TextBlock Text="استيراد جميع أوراق ملف Excel (بدلا من الورقة الأولى فقط)"
                                               TextWrapping="Wrap"/>
                                </CheckBox>
                                <Button Content="اختيار كشف Excel من الجهاز"
                                        Click="PickWorkbook_OnClick"
                                        Style="{StaticResource ImportButton}"
                                        IsEnabled="{Binding CanPickFile}"
                                        HorizontalAlignment="Right"
                                        AutomationProperties.Name="اختر ملف XLSX محليا دون حفظ"/>
                                <TextBlock Text="{Binding FileDescription}"
                                           Foreground="#334155" TextWrapping="Wrap"
                                           Margin="0,7,0,0"/>
                                <ProgressBar Height="4" IsIndeterminate="True"
                                             Visibility="{Binding IsBusy, Converter={StaticResource ImportVisible}}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1"
                                BorderThickness="1" CornerRadius="6" Padding="10"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="الخطوة الثانية — معاينة الصفوف والنتائج من SQLCipher دون حفظ"
                                           FontWeight="Bold" Foreground="#0F2942"/>
                                <Button Content="تحليل الملف وإنشاء معاينة مؤقتة دون حفظ"
                                        Style="{StaticResource ImportButton}"
                                        Command="{Binding PreviewCommand}"
                                        HorizontalAlignment="Right"
                                        AutomationProperties.Name="معاينة الأفراد والمواقع المضافة والتكرارات دون حفظ"/>
                                <TextBlock Text="{Binding Error}" Foreground="#BE123C"
                                           TextWrapping="Wrap" FontWeight="SemiBold"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource ImportVisible}}">
                                    <TextBlock Text="{Binding PreviewDescription}" Foreground="#0F2942"
                                               TextWrapping="Wrap" FontWeight="SemiBold"
                                               Margin="0,8,0,9"/>
                                    <TextBlock Text="الصفوف المقبولة — معاينة أول 100 عند وجود أكثر"
                                               Foreground="#0F2942" FontWeight="SemiBold"/>
                                    <DataGrid ItemsSource="{Binding Preview.AcceptedRows}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" Height="140" Margin="0,5,0,7"
                                              AlternatingRowBackground="#F8FAFC">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="الورقة" Binding="{Binding Worksheet}" Width="*"/>
                                            <DataGridTextColumn Header="الصف" Binding="{Binding Row}" Width="65"/>
                                            <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                                            <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="*"/>
                                            <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="الصفوف المرفوضة وأسبابها (لا تُنشأ هويات لها)"
                                               Foreground="#9A3412" FontWeight="SemiBold"/>
                                    <DataGrid ItemsSource="{Binding Preview.Issues}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" Height="115" Margin="0,5,0,6"
                                              AlternatingRowBackground="#FFF7ED">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="الورقة" Binding="{Binding Worksheet}" Width="*"/>
                                            <DataGridTextColumn Header="الصف" Binding="{Binding Row}" Width="60"/>
                                            <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                                            <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="*"/>
                                            <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="3*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="المواقع الجديدة المقترحة — لا تُنشأ إلا بعد الموافقة"
                                               Foreground="#0F2942" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding Preview.NewSites}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text=" — أفراد: "/>
                                                    <TextBlock Text="{Binding PersonCount}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A"
                                BorderThickness="1" CornerRadius="6"
                                Padding="10" Margin="0,0,0,8"
                                Visibility="{Binding HasPreview, Converter={StaticResource ImportVisible}}">
                            <StackPanel>
                                <TextBlock Text="الخطوة الثالثة — تأكيد مستقل قبل أي كتابة"
                                           FontWeight="Bold" Foreground="#92400E"/>
                                <CheckBox IsChecked="{Binding PersonnelApproved, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanEdit}" Margin="0,8,0,5"
                                          AutomationProperties.Name="أوافق على إنشاء الأفراد الجدد فقط">
                                    <TextBlock Text="راجعت الأسماء وأرقام (ع) المقبولة وأوافق على إنشاء هويات جديدة فقط دون استبدال هويات الأفراد الحاليين."
                                               TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding RejectedRowsReviewed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanEdit}" Margin="0,2,0,5"
                                          AutomationProperties.Name="أقر باستبعاد الصفوف المرفوضة">
                                    <TextBlock Text="راجعت أسباب رفض الصفوف المرفوضة، وأوافق على استبعادها مع الاحتفاظ بالأسباب في سجل الدفعة. لا يلزم هذا الإقرار إن لم توجد صفوف مرفوضة."
                                               TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding NewSitesApproved, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanEdit}" Margin="0,2,0,5"
                                          AutomationProperties.Name="أقر بإضافة المواقع الجديدة المبينة في المعاينة">
                                    <TextBlock Text="أوافق على إنشاء المواقع الجديدة المبينة أعلاه فقط؛ لا يلزم هذا الإقرار إذا لم توجد مواقع جديدة."
                                               TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding SimilarNamesReviewed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanEdit}" Margin="0,2,0,5"
                                          AutomationProperties.Name="أقر بمراجعة تحذيرات تشابه الأسماء">
                                    <TextBlock Text="راجعت عدد تحذيرات تشابه الأسماء. تشابه الاسم ليس إثباتا لوحدة الهوية؛ لا يلزم هذا الإقرار إذا لم توجد تحذيرات."
                                               TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <Button Content="اعتماد الاستيراد إلى SQLCipher مرة واحدة"
                                Command="{Binding ConfirmCommand}"
                                Style="{StaticResource ImportButton}"
                                AutomationProperties.Name="اعتماد كشف Excel المعاين بعد الموافقات المطلوبة"/>
                        <TextBlock Text="{Binding CompletionDescription}" Foreground="#0D9488"
                                   FontWeight="Bold" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="عند فقدان رد الحفظ، راجع سجل دفعات الاستيراد والأفراد قبل أي محاولة أخرى. لا يُعاد الاستيراد تلقائيا. تحديث أعمدة الأفراد الموجودين غير مفعّل في هذه المرحلة."
                                   Foreground="#64748B" TextWrapping="Wrap"
                                   FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
