<UserControl x:Class="AlTamam.NativeDesktop.Views.NativeAttendanceReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Segoe UI"
             AutomationProperties.Name="معاينة واعتماد تغيير الحالة">
    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <Style x:Key="NativeApprove" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource NativeAccentFill}"/>
            <Setter Property="Foreground" Value="{DynamicResource NativeOnStrong}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="NativeCancel" TargetType="Button" BasedOn="{StaticResource NativeApprove}">
            <Setter Property="Background" Value="{DynamicResource NativeSubtle}"/>
            <Setter Property="Foreground" Value="{DynamicResource NativeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NativeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>
    <!-- The only mutating button is ConfirmCommand, disabled until the actual
         SQLCipher server preview matches every selected PersonId. -->
    <Grid Background="#E60F2942" Panel.ZIndex="103">
        <Border Background="{DynamicResource NativeSurface}" CornerRadius="12" BorderBrush="{DynamicResource NativeBorder}"
                BorderThickness="1" Padding="18" Margin="16"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                MaxWidth="1040" MinHeight="340" MaxHeight="650"
                KeyboardNavigation.TabNavigation="Cycle">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <Button x:Name="CancelReviewButton"
                            Content="إلغاء المراجعة" Command="{Binding CancelCommand}"
                            Style="{StaticResource NativeCancel}" DockPanel.Dock="Left"/>
                    <StackPanel>
                        <TextBlock Text="{Binding ReviewTitle}" Foreground="{DynamicResource NativeText}"
                                   FontWeight="Bold" FontSize="20"/>
                        <TextBlock Text="لن يتغير أي سجل قبل معاينة الخادم والتأكيد النهائي"
                                   Foreground="{DynamicResource NativeMuted}" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource NativeCanvas}" CornerRadius="8"
                        BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                        Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="الحالة الجديدة" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NativeText}" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <ComboBox MinWidth="240" Height="38" VerticalAlignment="Center"
                                      ItemsSource="{Binding StatusChoices}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="StatusId"
                                      SelectedValue="{Binding SelectedStatusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanEditSelection}"
                                      AutomationProperties.Name="اختر الحالة الجديدة"/>
                            <Button Content="متابعة إلى المعاينة" Command="{Binding PreviewCommand}"
                                    Style="{StaticResource NativeApprove}"/>
                        </WrapPanel>
                        <StackPanel Margin="0,9,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RequiresDateRange}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <WrapPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="بداية الإجازة أو الإذن" FontWeight="SemiBold"
                                               Foreground="{DynamicResource NativeText}" Margin="0,0,0,4"/>
                                    <DatePicker Width="190" Height="36" Padding="4"
                                                SelectedDate="{Binding RangeStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding CanEditRange}"
                                                AutomationProperties.Name="تاريخ بداية الإجازة أو الإذن"/>
                                </StackPanel>
                                <StackPanel Margin="12,0,0,6">
                                    <TextBlock Text="نهاية الإجازة أو الإذن" FontWeight="SemiBold"
                                               Foreground="{DynamicResource NativeText}" Margin="0,0,0,4"/>
                                    <DatePicker Width="190" Height="36" Padding="4"
                                                SelectedDate="{Binding RangeEndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding CanEditRange}"
                                                AutomationProperties.Name="تاريخ نهاية الإجازة أو الإذن"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="تبدأ المدة من تاريخ تحضير اليوم، ولا تزيد على 366 يوما. لا يتم الحفظ إلا بعد المعاينة والتأكيد."
                                       Foreground="{DynamicResource NativeMuted}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="2" Text="{Binding PreviewMessage}" FontSize="14"
                           FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource NativeText}" Margin="2,0,2,9"/>
                <DataGrid Grid.Row="3" ItemsSource="{Binding PreviewPersons}"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" FlowDirection="RightToLeft"
                          AlternatingRowBackground="{DynamicResource NativeSubtle}"
                          BorderBrush="{DynamicResource NativeBorder}" BorderThickness="1"
                          RowHeight="36" ColumnHeaderHeight="39"
                          MinHeight="145" MaxHeight="285">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="الرقم (ع)" Binding="{Binding ServiceNumberA}" Width="115"/>
                        <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="*"/>
                        <DataGridTextColumn Header="الحالة السابقة" Binding="{Binding PreviousStatusName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="4" Margin="0,10,0,4">
                    <StackPanel Margin="0,0,0,5">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DraftSaveAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="حفظ مسودة دون اعتماد الحضور" Command="{Binding SaveDraftCommand}"
                                HorizontalAlignment="Right" Padding="12,6"
                                AutomationProperties.Name="حفظ مؤقت دون اعتماد التمام"/>
                        <TextBlock Text="حفظ مؤقت للحالات التي لا تتطلب مدة؛ الإجازة والإذن غير متاحين للحفظ المؤقت حاليا."
                                   TextWrapping="Wrap" Foreground="{DynamicResource NativeMuted}" Margin="0,4"/>
                        <TextBlock Text="{Binding DraftMessage}" Foreground="{DynamicResource NativeText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource NativeDangerText}"
                               FontWeight="SemiBold" FontSize="13"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                    <TextBlock Foreground="{DynamicResource NativeAccentText}" FontWeight="Bold"
                               FontSize="13" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="تم اعتماد الحالات وحفظها في سجل العمليات. رقم التدقيق: "/>
                        <Run Text="{Binding AuditEventId}"/>
                    </TextBlock>
                </StackPanel>
                <DockPanel Grid.Row="5" Margin="0,7,0,0">
                    <Button Content="إلغاء دون حفظ" Command="{Binding CancelCommand}"
                            Style="{StaticResource NativeCancel}" DockPanel.Dock="Left"/>
                    <Button Content="{Binding ConfirmButtonText}" Command="{Binding ConfirmCommand}"
                            Style="{StaticResource NativeApprove}" DockPanel.Dock="Right"
                            AutomationProperties.Name="تأكيد واعتماد التغييرات بعد معاينة الخادم"/>
                    <TextBlock Text="الاعتماد ينفذ معاملة واحدة ويسجل عمليات جميع الأفراد"
                               Foreground="{DynamicResource NativeSecondary}" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
