<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AlTamam.NativeDesktop</RootNamespace>
    <AssemblyName>AlTamam.NativeDesktop.Pilot</AssemblyName>
    <ApplicationIcon>../AlTamam.DesktopHost/Assets/AlTamam.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AlTamam.NativePresentation/AlTamam.NativePresentation.csproj" />
    <ProjectReference Include="../AlTamam.Application/AlTamam.Application.csproj" />
    <ProjectReference Include="../AlTamam.Infrastructure/AlTamam.Infrastructure.csproj" />
    <Resource Include="../AlTamam.DesktopHost/Assets/AlTamam.ico" Link="Assets/AlTamam.ico" />
    <!-- Build the exact original audited scheduler source in the new WPF host.
         No copy, fork, duplicate scheduling policy, or desktop-host runtime dep. -->
    <Compile Include="../AlTamam.DesktopHost/Scheduling/EightPmSchedulerService.cs"
             Link="Scheduling/EightPmSchedulerService.cs" />
    <Compile Include="../AlTamam.DesktopHost/Scheduling/AutomaticBackupSchedulerService.cs"
             Link="Scheduling/AutomaticBackupSchedulerService.cs" />
  </ItemGroup>
</Project>
